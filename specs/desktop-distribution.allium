-- allium: 3
-- Scope: distribución estable y actualización de Vera Desktop.

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

external entity DesktopUser {}
external entity ReleaseProvider {}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract DesktopUpdateSafety {
    @invariant MemorySurvivesProgramReplacement
        -- Instalar, actualizar o desinstalar el programa no elimina ni reemplaza
        -- la memoria personal ubicada fuera de los archivos de la aplicación.

    @invariant PortableEditionsNeverSelfReplace
        -- Una edición portable puede avisar, pero nunca reemplaza su ejecutable.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum DesktopPlatform { windows | macos | linux }
enum InstallationKind { installed | portable }
enum UpdateState { current | offered | downloading | ready | failed }
enum ReleaseChannel { stable | legacy }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity DesktopInstallation {
    owner: DesktopUser
    platform: DesktopPlatform
    kind: InstallationKind
    installed_version: String
    available_version: String?
    update_state: UpdateState
    memory_path: String
    release_channel: ReleaseChannel
}

entity StableRelease {
    version: String
    published: Boolean
    windows_installer_available: Boolean
    mac_installer_available: Boolean
    linux_installer_available: Boolean
    update_metadata_available: Boolean
    signed_for_windows: Boolean
    signed_for_macos: Boolean
    notarized_for_macos: Boolean
}

-- Distribución temprana, sin firma comercial, mientras la firma de Windows y
-- la notarización de Apple no son alcanzables para quien mantiene Vera. No
-- reemplaza a StableRelease ni relaja sus garantías: es una categoría propia
-- que nunca pretende la confianza de una release firmada, y nunca participa
-- de la actualización automática (ver AlphaReleasesDiscloseUnsignedRisk).
entity AlphaRelease {
    version: String
    published: Boolean
    windows_installer_available: Boolean
    mac_installer_available: Boolean
    checksum_available: Boolean
    unsigned_warning_disclosed: Boolean
}

-- Edición deliberadamente fijada a un runtime antiguo para mantener habitable
-- un sistema operativo que la distribución contemporánea ya no admite. No
-- participa del canal de actualización estable: actualizar el programa sin
-- comprobar el sistema operativo puede convertir una instalación viva en una
-- aplicación que ya no abre.
entity LegacyRelease {
    version: String
    published: Boolean
    mac_catalina_intel_available: Boolean
    checksum_available: Boolean
    unsigned_warning_disclosed: Boolean
    unsupported_runtime_disclosed: Boolean
    automatic_updates_available: Boolean
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    check_interval: Duration = 6.hours
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule OfferStableUpdate {
    when: StableUpdateFound(installation, release)
    requires: installation.kind = installed
    requires: installation.release_channel = stable
    requires: release.published
    requires: release.update_metadata_available
    requires: release.version != installation.installed_version
    requires:
        installation.platform = windows and release.windows_installer_available and release.signed_for_windows
        or installation.platform = macos and release.mac_installer_available and release.signed_for_macos and release.notarized_for_macos
        or installation.platform = linux and release.linux_installer_available
    ensures:
        installation.available_version = release.version
        installation.update_state = offered
}

rule UserAcceptsDownload {
    when: DownloadUpdate(user, installation)
    requires: installation.owner = user
    requires: installation.update_state = offered
    ensures: installation.update_state = downloading
}

rule DownloadBecomesReady {
    when: UpdateVerified(installation)
    requires: installation.update_state = downloading
    ensures: installation.update_state = ready
}

rule DownloadFailsSafely {
    when: UpdateDownloadFailed(installation)
    requires: installation.update_state = downloading
    ensures: installation.update_state = failed
}

rule UserAppliesPreparedUpdate {
    when: ApplyPreparedUpdate(user, installation)
    requires: installation.owner = user
    requires: installation.update_state = ready
    ensures:
        installation.installed_version = installation.available_version
        installation.available_version = null
        installation.update_state = current
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- Cada plataforma es confiable por sí sola: no exige que las tres estén
-- listas a la vez. Linux no requiere firma ni notarización porque no existe
-- un bloqueo equivalente a SmartScreen o Gatekeeper para AppImage/deb; ya
-- puede publicarse como StableRelease sin esperar a Windows o macOS.
invariant StableReleasePlatformsAreTrusted {
    for release in StableReleases:
        (release.published implies
            release.update_metadata_available and
            (release.windows_installer_available or release.mac_installer_available or release.linux_installer_available))
        and (release.windows_installer_available implies release.signed_for_windows)
        and (release.mac_installer_available implies release.signed_for_macos and release.notarized_for_macos)
}

-- Lo que SÍ garantiza una AlphaRelease: identidad verificable del build
-- (checksum) y que quien la publicó divulgó expresamente, en las notas o la
-- documentación de esa release, que no está firmada y cómo sortear el aviso
-- del sistema operativo. No finge la confianza de StableRelease.
invariant AlphaReleasesDiscloseUnsignedRisk {
    for release in AlphaReleases:
        release.published implies
            release.checksum_available and
            release.unsigned_warning_disclosed and
            (release.windows_installer_available or release.mac_installer_available)
}

invariant LegacyReleasesRemainManualAndExplicit {
    for release in LegacyReleases:
        release.published implies
            release.mac_catalina_intel_available and
            release.checksum_available and
            release.unsigned_warning_disclosed and
            release.unsupported_runtime_disclosed and
            not release.automatic_updates_available
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor DesktopOwner {
    within: DesktopInstallation
    identified_by: DesktopUser where this = within.owner
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface DesktopUpdateExperience {
    facing user: DesktopOwner
    context installation: DesktopInstallation where owner = user

    exposes:
        installation.installed_version
        installation.available_version
        installation.update_state

    provides:
        DownloadUpdate(user, installation) when installation.update_state = offered
        ApplyPreparedUpdate(user, installation) when installation.update_state = ready

    contracts:
        fulfils DesktopUpdateSafety

    @guarantee ExplicitDownload
        -- Vera no descarga una versión nueva antes de que la persona acepte.

    @guarantee DeferrableInstallation
        -- Una actualización preparada puede instalarse ahora o al cerrar Vera.
}

surface StableReleaseFeed {
    facing provider: ReleaseProvider

    provides:
        StableUpdateFound(installation, release)
        UpdateVerified(installation)
        UpdateDownloadFailed(installation)

    contracts:
        demands DesktopUpdateSafety
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "¿Cuándo se abrirá un canal beta separado del canal estable?"
