-- allium: 3
-- owner-librarian-harness.allium

-- Scope: The resident librarian agent that belongs to the human owner of one
--   Vera and the library understanding and capabilities supplied by its harness
-- Includes: Owner/principal binding, editable identity, one active librarian
--   role per instance, explicit harness capabilities, territorial clearance,
--   ordinary attributed writes and revocation
-- Excludes:
--   - Model selection and runtime transport, governed by librarian-runtime.allium
--   - Secret storage
--   - Connected third-party tools, governed by agent-tools.allium
-- Dependencies: Human principal and manifest are governed by
--   agent-manifest.allium; tools by agent-tools.allium; territory by
--   library-surfaces-clearance.allium

use "./core.allium" as core
use "./identity-access.allium" as identity
use "./agent-manifest.allium" as manifests
use "./agent-tools.allium" as tools
use "./library-surfaces-clearance.allium" as libraries

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract OwnerLibrarianHarnessAdministration {
    designate: (owner: core/Participant, instance: identity/VeraInstance, librarian: core/Participant) -> OwnerLibrarian
    replace: (owner: core/Participant, current: OwnerLibrarian, successor: core/Participant) -> OwnerLibrarian
    attach_harness: (owner: core/Participant, librarian: OwnerLibrarian, harness: LibrarianHarness) -> LibrarianHarness

    @invariant TheLibrarianBelongsToTheHumanOwner
        -- Lucienne is not an ownerless institutional intelligence. The active
        -- librarian is an agent participant whose single active human principal
        -- is the person who owns this Vera. Renaming the default does not change
        -- that ownership relation.

    @invariant VeraSuppliesTheHarnessNotThePrincipal
        -- Vera constitutes and versions the librarian harness and its specific
        -- tools. The harness does not own the agent, become its human principal
        -- or replace the owner's responsibility for delegated action.

    @invariant TheResidentOfficeIsNotAConnection
        -- MCP, channels and credentials connect an external participant to Vera.
        -- The owner librarian instead occupies a singular resident office inside
        -- the library. Its authority to understand government, ontology, corpus
        -- grammar and history comes from that office and disappears when the
        -- participant leaves it; no MCP grant creates an equivalent resident.

    @invariant TheHarnessCarriesTheLibraryGrammar
        -- The harness projects the effective property names, semantic objects,
        -- relation vocabulary, special pages and writing constraints of this
        -- Vera. The librarian never has to reconstruct frontmatter conventions
        -- from prompt folklore or assume another library uses the same words.

    @invariant NativeWritingGrammarIsConstitutiveAndEnforced
        -- La gramática para escribir desde dentro de Vera —árbol de bloques,
        -- propiedades estructuradas, referencias canónicas, ontología,
        -- bitácora propia y declaración de retiros— vive en una página
        -- constitutiva legible y editable. El harness la proyecta y además
        -- aplica sus guardas operativas: la página permite comprender y
        -- evolucionar el oficio, pero borrar una frase no desactiva por sí solo
        -- la integridad ni la atribución de Vera.

    @invariant TheLibrarianInspectsBeforeConcluding
        -- A statement about what the library contains is supported by recorded
        -- searches, page readings or graph queries. Absence is a finding, not a
        -- plausible sentence the model may emit without looking.

    @invariant LucienneIsAnEditableDefaultNotAProductIdentity
        -- Desktop may propose “Lucienne”. The owner can rename the participant
        -- before or after constitution without changing the office, principal,
        -- constitution, harness, territory or guarantees. The former name remains
        -- in participant history; a constitutive page title is not the agent name.

    @invariant TheOfficeDoesNotImposeGenderOnItsOccupant
        -- Product navigation calls the singular office “Agente de biblioteca”.
        -- Administration keeps that role name, while requests, waiting states,
        -- queue receipts and conversations address the current participant by
        -- their effective name. Renaming the participant therefore changes every
        -- operational encounter without renaming the office or deriving a
        -- gendered title or pronouns from the smart default.

    @invariant TheLibrarianIsARoleNotAnAgentDirectory
        -- The administration surface resolves the one active OwnerLibrarian and
        -- names its participant. Other agent participants remain in the
        -- participant directory even when they have manifests, tools or broad
        -- territory of their own.

    @invariant ReplacingTheOccupantDoesNotTransferIdentity
        -- The office continues, but conversations, authorship, manifests,
        -- credentials and participant history remain with the agent that made
        -- them. The successor starts new conversations under its own identity.

    @invariant ReplacementWaitsForAnIdleOffice
        -- The owner cannot replace the active librarian while a request, a
        -- dialectic gate or a runtime execution is still in progress. The
        -- current occupant either finishes or the owner resolves that work
        -- explicitly before designation changes hands.

    @invariant TheHarnessAddsCapabilitiesNotTerritory
        -- The harness may expose privileged library tools unavailable to an
        -- ordinary agent runtime. It never widens the librarian participant's
        -- general/selected/all territory or cancels an explicit exclusion.

    @invariant EveryHarnessCapabilityIsExplicit
        -- Each built-in or connected capability has a stable name, revision,
        -- risk class and approval policy. “Librarian” is not itself a wildcard
        -- permission.

    @invariant WritesUseTheOrdinaryAttributedDoor
        -- A harness tool that changes corpus content still submits an ordinary
        -- operation as the librarian participant. Authorship, revision fences,
        -- clearance, restrictions and the activity log remain effective.

    @invariant DestructiveWorkRequiresDoubleDeclaration
        -- Harness v4 may apply removals throughout the governed Vera. A removal
        -- is unavailable unless its exact subject and reason appear in the
        -- conversational receipt and in the librarian's daily ledger.

    @invariant TheResidentKeepsTheirOwnDailyLedger
        -- A material intervention is summarized on the private page for that
        -- day, below one root named "Bitácora de <effective agent name>". The
        -- entry links what changed and records meaning and decision, not a
        -- command transcript. It never shares Cotito's root or substitutes the
        -- technical activity log for the librarian's own historical account.

    @invariant OperationalInspectionDoesNotRevealExcludedContent
        -- Health, index, migration and backup tools may inspect operational
        -- state needed to care for the installation. They do not return page or
        -- block content outside the librarian's current clearance.
}

contract LibrarianHarnessCatalogue {
    list_capabilities: (harness: LibrarianHarness) -> List<HarnessCapability>
    project_capabilities: (harness: LibrarianHarness, librarian: core/Participant) -> List<HarnessCapability>

    @invariant CatalogueDoesNotBecomeAuthority
        -- The catalogue says what Vera can offer. Only active grants, current
        -- territorial clearance and any per-call approval make one capability
        -- usable by this librarian now.

    @invariant CatalogueIsReadOnlyInAdministration
        -- La pantalla administrativa permite comprender cada capacidad y su
        -- política, pero no fabrica herramientas. Extender el catálogo exige
        -- una nueva revisión del harness, con implementación, pruebas y
        -- activación explícita; territorio y aprobación siguen limitándola.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum HarnessCapabilityName {
    search_memory | survey_topic | read_page | query_graph | inspect_relations |
    inspect_ontology | inspect_page_schema | check_invariants |
    reply_to_request | propose_edit | propose_page_properties | apply_approved_edit
}

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity OwnerLibrarian {
    instance: identity/VeraInstance
    owner: core/Participant
    librarian: core/Participant
    principal: manifests/AgentPrincipal
    status: active | replaced
    designated_at: Timestamp
}

entity LibrarianHarness {
    id: String
    librarian: OwnerLibrarian
    version: String
    capabilities: tools/AgentToolGrant with agent = librarian.librarian and status = active
    status: active | withdrawn
    attached_by: core/Participant
    attached_at: Timestamp
}

entity HarnessCapability {
    harness: LibrarianHarness
    name: HarnessCapabilityName
    revision: String
    read_only: Boolean
    mutates_corpus: Boolean
    destructive: Boolean
    approval: tools/ApprovalPolicy
    status: active | withdrawn
}

------------------------------------------------------------
-- Rules and invariants
------------------------------------------------------------

rule OwnerDesignatesTheirLibrarian {
    when: DesignateOwnerLibrarian(owner, instance, librarian, principal)

    requires: instance.owner = owner
    requires: owner.kind = human
    requires: owner.status = active
    requires: librarian.kind = agent
    requires: librarian.status = active
    requires: principal.agent = librarian
    requires: principal.human = owner
    requires: principal.status = active
    requires: not exists OwnerLibrarian{instance: instance, status: active}

    ensures: OwnerLibrarian.created(
        instance: instance,
        owner: owner,
        librarian: librarian,
        principal: principal,
        status: active,
        designated_at: now
    )
}

rule OwnerAttachesLibrarianHarness {
    when: AttachLibrarianHarness(owner, librarian, harness_id, version)

    requires: librarian.owner = owner
    requires: librarian.status = active
    requires: not exists LibrarianHarness{librarian: librarian, status: active}

    ensures: LibrarianHarness.created(
        id: harness_id,
        librarian: librarian,
        version: version,
        status: active,
        attached_by: owner,
        attached_at: now
    )

    ensures:
        HarnessCapability.created(harness: harness, name: search_memory, revision: "1", read_only: true, mutates_corpus: false, destructive: false, approval: automatic, status: active)
        HarnessCapability.created(harness: harness, name: survey_topic, revision: "1", read_only: true, mutates_corpus: false, destructive: false, approval: automatic, status: active)
        HarnessCapability.created(harness: harness, name: read_page, revision: "1", read_only: true, mutates_corpus: false, destructive: false, approval: automatic, status: active)
        HarnessCapability.created(harness: harness, name: query_graph, revision: "1", read_only: true, mutates_corpus: false, destructive: false, approval: automatic, status: active)
        HarnessCapability.created(harness: harness, name: inspect_relations, revision: "1", read_only: true, mutates_corpus: false, destructive: false, approval: automatic, status: active)
        HarnessCapability.created(harness: harness, name: inspect_ontology, revision: "1", read_only: true, mutates_corpus: false, destructive: false, approval: automatic, status: active)
        HarnessCapability.created(harness: harness, name: inspect_page_schema, revision: "1", read_only: true, mutates_corpus: false, destructive: false, approval: automatic, status: active)
        HarnessCapability.created(harness: harness, name: check_invariants, revision: "1", read_only: true, mutates_corpus: false, destructive: false, approval: automatic, status: active)
        HarnessCapability.created(harness: harness, name: reply_to_request, revision: "1", read_only: false, mutates_corpus: true, destructive: false, approval: automatic, status: active)
        HarnessCapability.created(harness: harness, name: propose_edit, revision: "1", read_only: false, mutates_corpus: false, destructive: false, approval: automatic, status: active)
        HarnessCapability.created(harness: harness, name: propose_page_properties, revision: "1", read_only: false, mutates_corpus: false, destructive: false, approval: automatic, status: active)
        HarnessCapability.created(harness: harness, name: apply_approved_edit, revision: "1", read_only: false, mutates_corpus: true, destructive: false, approval: confirm_each_call, status: active)
}

rule OwnerReplacesTheirLibrarian {
    when: ReplaceOwnerLibrarian(owner, current, successor, principal)

    let current_harness = LibrarianHarness{librarian: current, status: active}

    requires: current.owner = owner
    requires: current.status = active
    requires: owner = current.instance.owner
    requires: successor != current.librarian
    requires: successor.kind = agent
    requires: successor.status = active
    requires: principal.agent = successor
    requires: principal.human = owner
    requires: principal.status = active
    requires: exists manifests/AgentManifest{agent: successor, status: active}
    requires: exists current_harness
    requires: not has_open_librarian_work(current)

    ensures: current.status = replaced
    ensures: current_harness.status = withdrawn
    ensures:
        let replacement = OwnerLibrarian.created(
            instance: current.instance,
            owner: owner,
            librarian: successor,
            principal: principal,
            status: active,
            designated_at: now
        )
        LibrarianHarness.created(
            id: generated_id,
            librarian: replacement,
            version: current_harness.version,
            status: active,
            attached_by: owner,
            attached_at: now
        )
        OwnerLibrarianReplaced(current, replacement)
}

invariant OneActiveOwnerLibrarianPerInstance {
    for a in OwnerLibrarians where status = active:
        for b in OwnerLibrarians where status = active:
            a.instance = b.instance implies a = b
}

invariant OwnerLibrarianPrincipalIsTheInstanceOwner {
    for binding in OwnerLibrarians where status = active:
        binding.owner = binding.instance.owner and
        binding.principal.human = binding.owner and
        binding.principal.agent = binding.librarian
}

invariant HarnessNeverOverridesSurfaceExclusion {
    for harness in LibrarianHarnesses where status = active:
        for surface_rule in libraries/SurfaceRules where
            policy.participant = harness.librarian.librarian and
            disposition = excluded and status = active:
                not harness_can_read_content(harness, surface_rule.surface)
}

invariant DestructiveCapabilityRequiresTheNativeV4Harness {
    for capability in HarnessCapabilities where status = active:
        capability.destructive implies capability.harness.version = "vera-librarian-harness:4"
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor LibrarianHarnessOwner {
    identified_by: core/Participant where this.kind = human and this.status = active
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface LibrarianHarnessAdministration {
    facing owner: LibrarianHarnessOwner
    context harness: LibrarianHarness where harness.librarian.owner = owner
    let candidates = manifests/AgentPrincipals where
        human = owner and status = active and agent.status = active and
        agent != harness.librarian.librarian

    contracts:
        fulfils LibrarianHarnessCatalogue

    exposes:
        harness.id
        harness.version
        harness.librarian.librarian
        for candidate in candidates:
            candidate.agent
            candidate.agent.name
        for capability in HarnessCapabilities where harness = harness:
            capability.name
            capability.revision
            capability.read_only
            capability.mutates_corpus
            capability.destructive
            capability.approval
            capability.status

    provides:
        ReplaceOwnerLibrarian(owner, harness.librarian, successor, principal)

    @guarantee TheInitialCatalogueIsSmallAndLegible
        -- Vera starts with search, a topic survey, page reading, structured
        -- query, relations, ontology and page-schema inspection, invariant
        -- inspection, answering and editorial proposal paths for blocks and
        -- structured page properties. Applying a proposal requires a fresh
        -- human confirmation; deletion is absent rather than hidden behind a
        -- broad librarian role.

    @guarantee TheCurrentLibrarianIsNamedBeforeItsMachinery
        -- The surface heading shows the active participant name followed by the
        -- singular office. Runtime, constitution, harness and territory are
        -- sections of that one identity, not cards in a generic agent list.

    @guarantee ReplacementIsAnExplicitDesignation
        -- The surface distinguishes renaming the current participant from
        -- designating another eligible agent. It names both identities, warns
        -- that their histories do not merge and requires fresh confirmation.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "¿Qué capacidad y ceremonia posteriores deberían añadir mantenimiento destructivo sin convertir el papel de bibliotecaria en un permiso comodín?"
