-- allium: 3
-- controlled-ontology.allium

-- Scope: Centrally governed semantic types for Vera content
-- Includes: Composable types, pending classification suggestions, curator
--   confirmation, human correction, and a deliberately small starter ontology
-- Excludes:
--   - Automated classification models and confidence algorithms
--   - Free-form tags
--   - Query syntax and visual presentation
--   - Domain-specific lifecycle rules for individual semantic types

use "./core.allium" as core
use "./agent-participation.allium" as agent

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum AssignmentStatus { suggested | confirmed | rejected }

-- En qué estado está una palabra del vocabulario.
--
-- Un vocabulario que sólo crece es un vocabulario que nadie limpia, y uno que se
-- reescribe en silencio deja el corpus diciendo cosas que su autor no dijo. Por
-- eso una palabra se propone antes de regir, y se deprecia en vez de borrarse:
-- lo que ya se clasificó con ella sigue siendo legible.
enum VocabularyStatus { proposed | approved | deprecated }

-- Cómo se relaciona un concepto con otro. Los nombres son los de SKOS, que
-- lleva décadas resolviendo esto y con el que conviene poder hablar.
enum ConceptRelationKind { broader | related | exact_match | close_match }

-- Una migración se propone, se mira y sólo entonces corre.
enum MigrationStatus { previewed | applied | discarded }

-- Qué clase de valor admite una propiedad, que es lo que decide con qué se
-- contesta.
--
-- Una propiedad sin dominio declarado sólo puede ofrecer un campo de texto, y un
-- campo de texto es el peor instrumento posible para una pregunta cerrada: el
-- corpus de Vera llegó con un `type` cuyo valor era `": "` y con otro que
-- empaquetaba cinco tipos separados por barras. Ninguno de los dos es un
-- descuido de quien escribió; son la consecuencia de preguntar en abierto algo
-- que tenía tres respuestas posibles.
--
-- `free_text` no es la ausencia de dominio sino su declaración: hay propiedades
-- cuyo valor es genuinamente una frase, y decirlo es distinto de no haberlo
-- decidido nunca.
enum PropertyValueKind {
    boolean | one_of | concept | page_reference | external_url | date | number | free_text
}

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity Ontology {
    graph: core/Graph
    types: SemanticType with ontology = this
    categories: Category with ontology = this
    concepts: Concept with ontology = this
    relations: RelationDefinition with ontology = this
    assignments: TypeAssignment with ontology = this
    property_definitions: PropertyDefinition with ontology = this
}

entity SemanticType {
    ontology: Ontology
    name: String
    description: String
    property_definitions: PropertyDefinition with semantic_type = this
}

-- Una clasificación taxonómica. Cada categoría tiene como máximo una categoría
-- madre, de modo que el vocabulario forma un árbol y no varias jerarquías
-- traslapadas. Una página puede verse reunida con las demás que pertenecen a la
-- misma categoría sin convertir esa pertenencia en su tipo semántico.
entity Category {
    ontology: Ontology
    preferred_label: String
    definition: String
    parent: Category?
    status: VocabularyStatus
    children: Category with parent = this
    members: CategoryAssignment with category = this
}

entity CategoryAssignment {
    category: Category
    page: core/Page
    assigned_by: core/Participant
}

-- De qué trata algo, que no es lo mismo que qué clase de cosa es.
--
-- Una página puede ser una Publicación —eso es su tipo— y tratar sobre
-- accesibilidad cognitiva y sobre pictogramas —eso son sus conceptos. Confundir
-- las dos cosas es lo que hace que una etiqueta libre termine significando a
-- ratos «esto es» y a ratos «esto habla de», y que no se pueda consultar
-- ninguna de las dos con confianza.
--
-- Los tags libres del corpus no se tiran: son la evidencia de qué conceptos
-- hacían falta. Se conservan como fuente y su normalización se propone.
entity Concept {
    ontology: Ontology
    -- El concepto vive en el corpus: su título es el nombre canónico y sus
    -- bloques son el espacio, posiblemente vacío, donde se desarrolla.
    page: core/Page
    preferred_label: page.title
    definition: page.blocks
    -- Los demás nombres del mismo concepto. Absorbe mayúsculas, idioma y
    -- variantes ortográficas sin multiplicar identidades: el corpus ya escribe
    -- `lang` y `language`, `status` y `Estado`, y son uno.
    alt_labels: Set<String>
    status: VocabularyStatus
}

-- Que un concepto sea más amplio, más estrecho o vecino de otro.
--
-- No se fuerza una jerarquía única: el conocimiento de alguien no es un árbol, y
-- obligarlo a serlo hace que la mitad de las cosas cuelguen del sitio equivocado.
entity ConceptRelation {
    from: Concept
    to: Concept
    kind: ConceptRelationKind
}

-- Una relación entre entidades, con dirección.
--
-- Se guarda en una sola dirección y su inversa se deriva: `Persona member-of
-- Organización` permite preguntar por los miembros de una organización sin
-- mantener dos listas que puedan discrepar. Una relación derivada es un índice
-- reconstruible, nunca un dato que alguien edite.
entity RelationDefinition {
    ontology: Ontology
    name: String
    description: String
    -- Desde qué tipo sale y hacia cuáles puede apuntar.
    domain: SemanticType
    range: Set<SemanticType>
    -- Cuántas admite. Una relación multivaluada necesita cardinalidad de verdad
    -- en el modelo: comprimir varias en una cadena separada por comas convierte
    -- una consulta en una búsqueda de texto.
    multiple: Boolean
    -- El nombre de la inversa, cuando tiene sentido preguntar al revés. No se
    -- almacena: se calcula.
    derived_inverse: String?
    status: VocabularyStatus
}

-- Una relación afirmada entre dos cosas concretas.
entity RelationAssertion {
    definition: RelationDefinition
    -- Una relación a nivel de bloque no se guarda aparte. La glosa es la
    -- relación: sale de la página del bloque y llega a cada página enlazada en
    -- su contenido. Editar la glosa edita la relación; borrarla la retira.
    gloss_block: core/Block
    from: gloss_block.page
    to: core/Page
}

-- Una reescritura de citas, mirada antes de correr.
--
-- Existe como entidad y no como un botón porque hay un momento entre proponerla
-- y aplicarla en el que alguien tiene que poder verla: qué cambia, dónde y
-- cuánto. Ese momento es la diferencia entre una migración y un accidente.
entity CitationMigration {
    ontology: Ontology
    -- Qué se deja de escribir y qué se escribe en su lugar.
    from_label: String
    to_label: String
    -- Los bloques que cambiarían y cómo quedarían, calculados antes de tocar
    -- nada. Es lo que se enseña.
    affected: Set<AffectedCitation>
    status: MigrationStatus
    proposed_by: core/Participant
    applied_by: core/Participant?
    applied_at: Timestamp?
}

entity AffectedCitation {
    migration: CitationMigration
    block: core/Block
    -- El texto tal como está y tal como quedaría, entero: se compara lo que hay
    -- con lo que habría, no un resumen de la diferencia.
    current: String
    rewritten: String
}

-- Qué se puede contestar a una propiedad, que es lo que permite dibujarla como
-- un control y no como un campo vacío.
--
-- Es la pieza que faltaba. Sin dominio no hay forma de saber que `public` se
-- contesta con un interruptor y `status` con una lista, así que todo termina
-- siendo texto libre y la cabecera de una página termina siendo un formulario en
-- blanco que hay que rellenar de memoria.
entity PropertyDefinition {
    ontology: Ontology
    -- Nulo cuando la propiedad rige en todo el grafo y no sólo en un tipo. Hace
    -- falta que pueda serlo: el corpus declara `lang` en seiscientas páginas de
    -- las que once tienen tipo, y una definición que colgara sólo de un tipo
    -- dejaría sin gobierno justamente a la propiedad más usada.
    semantic_type: SemanticType?
    name: String
    description: String
    required: Boolean
    value_kind: PropertyValueKind
    -- Si admite varias respuestas a la vez. `tags` sí, `lang` no.
    --
    -- La cardinalidad es del modelo y no de la presentación: comprimir varios
    -- valores en una cadena separada por comas o barras convierte una consulta
    -- en una búsqueda de texto, y el corpus ya trae una página que lo hizo.
    multiple: Boolean
    options: PropertyOption with definition = this
    status: VocabularyStatus

    -- Lo que se puede ofrecer sin que nadie escriba nada.
    offerable: options where status = approved
}

-- Una respuesta admisible para una propiedad.
--
-- Nace propuesta y rige aprobada, como toda palabra del vocabulario. Dos
-- procedencias la producen y ninguna manda sobre la otra: alguien la declara, o
-- el corpus ya la venía usando y Vera lo hace notar. La segunda es la que
-- importa en un corpus heredado, donde el vocabulario real no está en ninguna
-- declaración sino en lo que se escribió durante años.
entity PropertyOption {
    definition: PropertyDefinition
    -- El valor tal como se escribe y se proyecta. Lo que cambia al elegir en un
    -- control es qué se ofrece, nunca cómo se guarda: el Markdown sigue diciendo
    -- `clave:: valor`, y un rediseño de la cabecera que cambiara el archivo
    -- sería una migración disfrazada de interfaz.
    value: String
    -- El concepto que este valor nombra, cuando la propiedad se contesta con
    -- vocabulario. Es lo que hace que `note` y `nota` no sean dos respuestas.
    concept: Concept?
    status: VocabularyStatus
    -- Cuántas veces el corpus lo dice ya. Es la evidencia de la propuesta y se
    -- enseña con ella: aprobar una palabra sabiendo que la usan cuatrocientas
    -- páginas y aprobarla sabiendo que la usa una son dos decisiones distintas.
    observed_uses: Integer
}

entity TypeAssignment {
    ontology: Ontology
    semantic_type: SemanticType
    page: core/Page?
    block: core/Block?
    status: AssignmentStatus
    rationale: String
    suggested_by: core/Participant
    decided_by: core/Participant?
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    -- Cómo se lee una página que nadie ha clasificado.
    --
    -- No es una asignación: es lo que la página dice de sí misma mientras nadie
    -- haya dicho otra cosa. Ver @guarantee AnUnclassifiedPageReadsAsANote.
    default_semantic_type: String = "nota"

    -- Cuántas veces tiene que aparecer un valor en el corpus para que Vera lo
    -- proponga como respuesta admisible. Por debajo de esto es una errata tan
    -- probablemente como un término.
    domain_proposal_threshold: Integer = 3

    -- Si lo que el bibliotecario declara sobre el grafo nace confirmado en vez
    -- de sugerido.
    --
    -- Verdadero por ahora y a sabiendas de lo que suspende. La razón es que una
    -- ontología vacía sobre mil páginas sin clasificar no se puebla a mano, y la
    -- alternativa —una bandeja de mil sugerencias que hay que despachar una por
    -- una— no produce más control sino una bandeja que se deja de mirar. Esto es
    -- la base operativa desde la que empezar a corregir, no el régimen final.
    --
    -- Lo que lo hace reversible es que cada asignación queda atribuida a quien
    -- la hizo. Se puede preguntar cuáles declaró un agente y devolverlas todas a
    -- sugeridas el día que este parámetro vuelva a ser falso, y ninguna decisión
    -- de una persona se pierde en esa vuelta.
    agent_assignments_are_born_confirmed: Boolean = true
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- Decir con qué se contesta una propiedad.
--
-- El acto que convierte un campo de texto en un control. Nada más: no reescribe
-- ningún valor existente, ni siquiera los que el dominio recién declarado no
-- admite. Lo que hace con ellos es dejarlos a la vista como lo que son, que es
-- distinto de corregirlos por su cuenta.
rule DeclarePropertyDomain {
    when: DefinePropertyDomain(
        participant, ontology, name, semantic_type, value_kind, multiple, required, description
    )

    -- Una persona, o un agente al que una persona autorizó este acto sobre esta
    -- propiedad. Ver agent/ExecutionIsDelegableAndJudgementIsNot.
    let delegation = agent/Delegation{
        granted_to: participant, act: "DefinePropertyDomain", subject: name
    }

    requires: participant.kind = human or (exists delegation and not delegation.spent)
    requires: semantic_type = null or semantic_type.ontology = ontology
    requires: not exists PropertyDefinition{ontology: ontology, name: name}

    ensures: PropertyDefinition.created(
        ontology: ontology,
        semantic_type: semantic_type,
        name: name,
        description: description,
        required: required,
        value_kind: value_kind,
        multiple: multiple,
        status: approved
    )

    @invariant DeclaringADomainRewritesNothing
        -- Declaring what a property admits does not touch a single value the
        -- corpus already carries, including the ones the new domain would not
        -- admit. A property that has been answered in eleven different ways for
        -- years is evidence about the vocabulary, and evidence that gets
        -- corrected on contact is evidence destroyed.
}

-- Leer el corpus y decir qué respuestas ya se están dando.
--
-- El vocabulario de un corpus heredado no está en ninguna declaración: está en
-- lo que se escribió durante años, y casi siempre nadie lo ha mirado junto. Esto
-- lo mira junto y lo propone; no decide.
--
-- Es la misma forma que todo lo demás aquí y que la voz: la máquina propone, la
-- persona declara.
rule ProposePropertyDomainFromUsage {
    when: ReadPropertyUsage(participant, ontology, definition)

    let membership = core/Membership{graph: ontology.graph, participant: participant}

    requires: exists membership
    requires: membership.status = active
    requires: definition.ontology = ontology

    ensures:
        for observed in observed_values(ontology.graph, definition.name):
            if observed.uses >= config.domain_proposal_threshold:
                PropertyOption.created(
                    definition: definition,
                    value: observed.value,
                    concept: null,
                    status: proposed,
                    observed_uses: observed.uses
                )

    @invariant ReadingUsageChangesNoPage
        -- What this produces are proposals about the vocabulary. Not one page's
        -- property is written, renamed or removed by it.
}

-- Absorber una propiedad de texto que decía lo que Vera ya gobierna.
--
-- El `public::` que llegó de Logseq es el caso que existe. Se lee, se convierte
-- en visibilidad de verdad, y la línea desaparece. Ausente significa privada, que
-- no es una interpretación: es lo que toda página es hasta que alguien decide lo
-- contrario.
--
-- Sólo lo corre una persona. Es la única regla de este archivo que borra
-- contenido del corpus, y esa es exactamente la clase de cosa que no se delega.
rule AdoptImportedVisibilityProperty {
    when: AdoptGovernedProperty(participant, ontology, page)

    let written = core/PropertyAssignment{page: page, key: "public"}

    requires: participant.kind = human
    requires: page.graph = ontology.graph
    requires: exists written

    ensures:
        core/ParticipantSubmits(
            participant: participant,
            graph: ontology.graph,
            origin_id: "adopt-public" + page.id,
            change: set_page_visibility(page, visibility_of(written.value)),
            channel: typed_text
        )
        core/ParticipantSubmits(
            participant: participant,
            graph: ontology.graph,
            origin_id: "drop-public" + page.id,
            change: remove_property(page, "public"),
            channel: typed_text
        )

    @invariant AbsentMeansPrivate
        -- Any value that does not plainly say public reads as private. An
        -- unparseable value is not a reason to publish something, and of the two
        -- ways to be wrong here only one is recoverable.

    @invariant AdoptionIsOrdinaryOperationsAndIsIdempotent
        -- Both halves reach the graph through the same operations any
        -- participant submits, so the change is attributed, ordered, auditable
        -- and undoable one page at a time. Running it twice does nothing the
        -- second time: the property is gone and the guard no longer holds.
}

rule ApprovePropertyOption {
    when: ApproveOption(participant, option)

    let delegation = agent/Delegation{
        granted_to: participant, act: "ApproveOption", subject: option.value
    }

    requires: participant.kind = human or (exists delegation and not delegation.spent)
    requires: option.status = proposed

    ensures: option.status = approved
}

-- Escribir una respuesta que el vocabulario todavía no tenía.
--
-- Se escribe de inmediato y nace propuesta. Es deliberado y es lo contrario de
-- lo que pide la intuición: un vocabulario cerrado que no crece en el punto de
-- uso no produce un corpus limpio, produce un corpus donde se dejó de etiquetar,
-- porque cada anotación pasó a costar un trámite. Lo que se gobierna no es que
-- la palabra entre, sino que entre marcada.
rule ParticipantAnswersWithANewWord {
    when: AnswerProperty(participant, ontology, definition, page, value)

    let membership = core/Membership{graph: ontology.graph, participant: participant}

    requires: exists membership
    requires: membership.status = active
    requires: definition.ontology = ontology
    requires: not exists PropertyOption{definition: definition, value: value}

    ensures:
        PropertyOption.created(
            definition: definition,
            value: value,
            concept: null,
            status: proposed,
            observed_uses: 0
        )
        core/ParticipantSubmits(
            participant: participant,
            graph: ontology.graph,
            origin_id: page.id + definition.name + value,
            change: set_property(page, definition.name, value),
            channel: typed_text
        )

    @invariant WritingNeverWaitsForCuration
        -- The value reaches the page in the same act that proposed the word.
        -- Nothing is held pending approval, because a note that cannot be
        -- finished until someone approves a word is a note that does not get
        -- written.

    @invariant AnsweringIsAnOrdinaryChange
        -- The property reaches the page through the same set_property a
        -- participant typing by hand would submit, with the same provenance and
        -- the same ordering. A control is a way of asking the question, never a
        -- shorter path to the graph.
}

rule SuggestPageSemanticType {
    when: SuggestPageType(participant, ontology, semantic_type, page, rationale)

    requires: semantic_type.ontology = ontology
    requires: page.graph = ontology.graph

    ensures: TypeAssignment.created(
        ontology: ontology,
        semantic_type: semantic_type,
        page: page,
        block: null,
        status: suggested,
        rationale: rationale,
        suggested_by: participant,
        decided_by: null
    )
}

rule SuggestBlockSemanticType {
    when: SuggestBlockType(participant, ontology, semantic_type, block, rationale)

    requires: semantic_type.ontology = ontology
    requires: block.page.graph = ontology.graph

    ensures: TypeAssignment.created(
        ontology: ontology,
        semantic_type: semantic_type,
        page: null,
        block: block,
        status: suggested,
        rationale: rationale,
        suggested_by: participant,
        decided_by: null
    )
}

-- Procesar una página: leerla y decir qué se ve en ella.
--
-- Un solo acto, deliberado y sobre una página concreta, del que salen
-- proposiciones de tres clases —qué es la página, qué nombra, y a qué apuntan
-- sus enlaces— y ninguna decisión. Es la misma forma que la voz: la máquina
-- propone, la persona declara.
--
-- Deliberado y no automático por dos razones. La primera es que clasificar de
-- oficio llenaría el corpus de sugerencias que nadie pidió y que hay que
-- desestimar una por una, y una bandeja que sólo crece se deja de mirar. La
-- segunda está abajo, en @invariant ReachingOutIsAnOutwardAct.
rule ParticipantProcessesAPage {
    when: ProcessPage(participant, ontology, page)

    let membership = core/Membership{graph: ontology.graph, participant: participant}

    requires: exists membership
    requires: membership.status = active

    ensures:
        for finding in readings_of(page):
            TypeAssignment.created(
                ontology: ontology,
                semantic_type: finding.semantic_type,
                page: page,
                block: null,
                status: suggested,
                rationale: finding.rationale,
                suggested_by: participant,
                decided_by: null
            )

    @invariant ProcessingProposesAndNothingMore
        -- Processing writes no content, changes no property and settles no type.
        -- What it leaves are suggestions, and a page processed and then ignored
        -- is exactly the page it was.

    @invariant ReachingOutIsAnOutwardAct
        -- Resolving what a link points at means asking the server that holds it,
        -- and asking tells that server that someone here is reading about this.
        -- A sovereign memory does not make that request behind its owner's back:
        -- it happens because they asked for it, on the page they asked it for,
        -- and what was requested is recorded.

    @invariant TheModelIsLocalOrThereIsNone
        -- The model that reads the page runs on this machine, like the one that
        -- transcribes voice. A corpus does not leave to be understood. Where no
        -- local model is available, processing does the part that needs none and
        -- says plainly which part it could not do.
}

-- Que un concepto sea más amplio que otro, o vecino suyo.
rule RelateConcepts {
    when: RelateConcept(participant, ontology, from, to, kind)

    requires: from.ontology = ontology
    requires: to.ontology = ontology
    requires: from != to

    ensures: ConceptRelation.created(from: from, to: to, kind: kind)
}

-- Fusionar dos conceptos que resultaron ser uno.
--
-- Pasa constantemente y no es un descuido: uno escribe `lang` un martes y
-- `language` un jueves, y ninguno de los dos estaba mal cuando se escribió. El
-- vocabulario se descubre usándolo.
--
-- La fusión es un acto de vocabulario y ocurre entera y al instante: el nombre
-- del absorbido pasa a ser un alias del que queda, así que todo lo que lo
-- nombraba —consultas, asignaciones, relaciones— apunta al mismo sitio desde ya.
-- Nada del texto se toca aquí. Reescribir las citas es otra cosa, viene después
-- y se pide aparte: ver rule MigrateCitations.
rule MergeConcepts {
    when: MergeConcept(participant, ontology, absorbed, surviving)

    let delegation = agent/Delegation{
        granted_to: participant, act: "MergeConcept", subject: absorbed.preferred_label
    }

    requires: absorbed.ontology = ontology
    requires: surviving.ontology = ontology
    requires: absorbed != surviving
    requires: participant.kind = human or (exists delegation and not delegation.spent)

    ensures:
        -- El nombre del absorbido sobrevive como alias. Es lo que hace que una
        -- cita escrita hace dos años siga resolviendo sin haberla tocado.
        surviving.alt_labels = surviving.alt_labels + absorbed.preferred_label + absorbed.alt_labels
        absorbed.status = deprecated
        for assignment in TypeAssignments where concept = absorbed:
            assignment.concept = surviving
        for relation in ConceptRelations where from = absorbed:
            relation.from = surviving
        for relation in ConceptRelations where to = absorbed:
            relation.to = surviving

    @invariant AMergeIsReversibleUntilTheTextMoves
        -- Fusionar no destruye el concepto absorbido: lo deprecia y le conserva
        -- sus nombres. Deshacerlo es devolverle el estado y separar los alias,
        -- y mientras nadie haya reescrito una cita eso basta.

    @invariant WhatWasWrittenStaysWritten
        -- Fusionar no cambia una palabra del corpus. Lo que un participante
        -- escribió sigue diciendo lo que escribió, y lo que cambia es a qué
        -- resuelve — que es una afirmación sobre el vocabulario, no sobre el
        -- texto de nadie.
}

-- Reescribir las citas para que el texto diga lo que el vocabulario ya sabe.
--
-- Un acto aparte, posterior y opcional. Vera funciona sin él: la fusión ya hizo
-- que todo resuelva. Esto existe porque un corpus donde la mitad de los enlaces
-- dicen `language` y la otra mitad `lang` es un corpus que se lee mal aunque
-- consulte bien, y porque quien escribe merece que su texto se parezca a lo que
-- ha decidido.
rule MigrateCitations {
    when: MigrateCitationsTo(participant, migration)

    -- Aquí el objeto de la autorización es la migración concreta, ya vista. No
    -- el par de palabras: una migración se aprueba habiendo mirado qué bloques
    -- cambian y cuántos, y ese cálculo es lo que se autorizó.
    let delegation = agent/Delegation{
        granted_to: participant, act: "MigrateCitationsTo", subject: migration.id
    }

    requires: participant.kind = human or (exists delegation and not delegation.spent)
    requires: migration.status = previewed

    ensures:
        for citation in migration.affected:
            core/ParticipantSubmits(
                participant: participant,
                graph: migration.ontology.graph,
                origin_id: migration.id + citation.block,
                change: edit_block(citation.block, citation.rewritten),
                channel: typed_text
            )
        migration.status = applied
        migration.applied_by = participant
        migration.applied_at = now

    @invariant NothingIsRewrittenUnseen
        -- Una migración se mira antes de correr: qué títulos cambian, en qué
        -- bloques y cuántos. Renombrar una palabra en seiscientas páginas sin
        -- que nadie las haya visto es indistinguible de que alguien haya escrito
        -- algo que nunca escribió.

    @invariant AMigrationIsOrdinaryOperations
        -- Cada bloque que cambia lo hace por el mismo `edit_block` que enviaría
        -- una persona escribiendo. Queda en el registro, con su secuencia y su
        -- procedencia, y se puede leer, auditar y deshacer uno por uno. Una vía
        -- rápida que escribiera en la base sin pasar por ahí dejaría un corpus
        -- con cambios que su propia historia no explica.

    @invariant MigratingLeavesTheHandAlone
        -- Un bloque que una migración reescribe conserva su autor y su fecha.
        -- Migrar no es escribir, igual que archivar no es escribir: quien corrió
        -- la migración cambió a qué apunta una cita, no dijo lo que el bloque
        -- dice.
        --
        -- Es la misma regla que agent/MovingLeavesTheHandAlone y se declara por
        -- la misma razón: «aquí la mano no cambia» es exactamente la clase de
        -- cosa que se implementa mal por omisión. Sin ella, migrar una palabra
        -- refirmaría seiscientos bloques a nombre de quien pulsó el botón, y en
        -- un corpus de varias manos eso borra justo lo que no se puede perder.
        --
        -- Qué migración tocó un bloque queda dicho aparte, de modo que «quién lo
        -- escribió» y «quién lo migró» sean dos preguntas con dos respuestas.

    @invariant AMigrationIsIdempotent
        -- Correrla dos veces no hace nada la segunda. Se interrumpe a mitad sin
        -- dejar el corpus a medio migrar, y se reanuda sin repetir lo hecho.
}

rule CuratorConfirmsSemanticType {
    when: ConfirmTypeAssignment(participant, assignment)

    requires: assignment.status = suggested

    ensures:
        assignment.status = confirmed
        assignment.decided_by = participant
}

rule CuratorRejectsSemanticType {
    when: RejectTypeAssignment(participant, assignment)

    requires: assignment.status = suggested

    ensures:
        assignment.status = rejected
        assignment.decided_by = participant
}

rule HumanCorrectsSemanticTypeDecision {
    when: CorrectTypeAssignment(participant, assignment, status)

    requires: participant.kind = human
    requires: status = confirmed or status = rejected

    ensures:
        assignment.status = status
        assignment.decided_by = participant
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant AssignmentTargetsOneContentEntity {
    for assignment in TypeAssignments:
        (assignment.page != null or assignment.block != null) and
        not (assignment.page != null and assignment.block != null)
}

invariant MultipleTypesMayDescribeOnePage {
    for assignment in TypeAssignments:
        assignment.page != null implies assignment.semantic_type.ontology = assignment.ontology
}

invariant ACategoryParentBelongsToTheSameOntology {
    for category in Categories:
        category.parent != null implies category.parent.ontology = category.ontology
}

invariant ACategoryIsNotItsOwnParent {
    for category in Categories:
        category.parent != category
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor OntologyParticipant {
    within: Ontology
    identified_by: core/Participant where core/Membership{participant: this, graph: within.graph}.status = active
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface OntologyCuration {
    facing participant: OntologyParticipant
    context ontology: Ontology

    exposes:
        ontology.types
        ontology.assignments
        ontology.property_definitions

    provides:
        DefinePropertyDomain(
            participant, ontology, name, semantic_type, value_kind, multiple, required, description
        )
        ReadPropertyUsage(participant, ontology, definition)
        ApproveOption(participant, option)
        AnswerProperty(participant, ontology, definition, page, value)
        AdoptGovernedProperty(participant, ontology, page)
        ProcessPage(participant, ontology, page)
        SuggestPageType(participant, ontology, semantic_type, page, rationale)
        SuggestBlockType(participant, ontology, semantic_type, block, rationale)
        RelateConcept(participant, ontology, from, to, kind)
        MergeConcept(participant, ontology, absorbed, surviving)
        MigrateCitationsTo(participant, migration)
        ConfirmTypeAssignment(participant, assignment) when assignment.ontology = ontology
        RejectTypeAssignment(participant, assignment) when assignment.ontology = ontology
        CorrectTypeAssignment(participant, assignment, status) when assignment.ontology = ontology

    @guarantee SuggestionsAreNotSilentAssignments
        -- Automated classification creates a visible pending suggestion.
        -- It does not silently classify content as confirmed.
        --
        -- Suspended while config.agent_assignments_are_born_confirmed holds, and
        -- suspended deliberately: an empty ontology over a thousand unclassified
        -- pages is not populated by hand. What keeps the suspension from being a
        -- loss is the word `silently`. Every assignment an agent makes is
        -- attributed to it and answerable as such, so "which of these did the
        -- librarian decide" is a question the corpus can answer, and returning
        -- them all to suggested is one operation. A confirmation nobody can
        -- trace is what this guarantee actually forbids, and that remains true
        -- with the parameter on.

    @guarantee GovernedStateAbsorbsTheTextThatDuplicatedIt
        -- An imported property that says in text what Vera governs as state is
        -- adopted into that state and then stops being a property. Visibility is
        -- the case that exists: `public:: false` becomes a private page and the
        -- line goes. Two places saying the same thing is one place too many, and
        -- the corpus already has pages where the two disagree.
        --
        -- Absent means private. A page that never said anything about being
        -- public is not making a claim Vera has to interpret; it is a page whose
        -- owner never published it, which is what every page is until someone
        -- decides otherwise.

    @guarantee ComposableTypes
        -- A page or block may have multiple confirmed semantic types.

    @guarantee HumanFinalAuthority
        -- A human participant can correct a confirmed or rejected assignment.

    @guarantee ProcessingSaysWhatItDidAndWhatItCouldNot
        -- Processing reports which links it resolved, which it could not reach,
        -- and whether it had a model to read the page with. A silent partial
        -- result is read as a complete one, and a participant will believe a
        -- page was understood when half of it was skipped.

    @guarantee ALinkResolvedKeepsItsAddress
        -- Learning what a link points at never replaces the address written in
        -- the block. The title arrives beside it, as a suggestion to name it,
        -- and the source stays exactly what its author typed.

    @guarantee InternalAndExternalLinksAreDifferentFields
        -- A page reference names another entity inside Vera. An external URL
        -- preserves and opens an address outside the corpus. Declaring one as
        -- the other would make navigation, validation and processing lie about
        -- which sovereignty owns the destination.

    @guarantee TypeAndTopicAreNeverTheSameQuestion
        -- What a page is and what it is about are asked separately and answered
        -- separately. A vocabulary that answers both at once with one word ends
        -- up answering neither: it is the failure mode of free tags, where
        -- `#pictograma` means «this is a pictogram» on one page and «this
        -- discusses pictograms» on the next, and no query can tell them apart.

    @guarantee CategoryAndConceptAreDifferentClassifications
        -- A category places a page in one explicit taxonomic tree whose nodes
        -- may have subcategories. A concept is a non-exclusive keyword or tag:
        -- concepts may overlap freely on the same page and do not determine the
        -- page's object type. Neither one is a synonym for semantic type.

    @guarantee ACategoryPageListsItsMembers
        -- Reaching a category shows its subcategories and every page assigned
        -- to it as derived views, in the same spirit as a wiki category page.
        -- The listing is not copied into the category's written content.

    @guarantee AnInverseIsDerivedAndNeverStored
        -- A relation is written once, in its canonical direction, and asking it
        -- backwards is answered by an index. Two stored directions are two
        -- chances to disagree, and the corpus would have no way to say which of
        -- the two was right.

    @guarantee VocabularyChangesAreMigrationsAndNotRewrites
        -- Accepting a change of vocabulary produces an explicit migration:
        -- reviewable before it runs, idempotent, attributed, and reversible.
        -- Renaming a word across six hundred pages in silence is indistinguishable
        -- from someone having written something they never wrote.

    @guarantee FreeTagsSurviveTheirNormalisation
        -- The tags a corpus already carries are kept as written. What a concept
        -- proposes is an additional reading of them, never a replacement: they
        -- are the evidence of which concepts were needed, and the evidence does
        -- not get overwritten by the conclusion.

    @guarantee SmallStarterOntology
        -- A new ontology starts with only Persona, Organizacion, Lugar,
        -- Proyecto, Tarea, Idea, Evento, Fuente and Publicacion.

    @guarantee AGovernedPropertyIsChosenAndAnUngovernedOneIsTyped
        -- A property with a declared domain is answered by choosing among what
        -- the domain admits. A property without one is answered by typing, and
        -- says so. The two must not look alike: a page whose front matter mixes
        -- settled questions with unsettled ones, drawn identically, teaches its
        -- reader that none of them are settled.

    @guarantee AVocabularyGrowsAtThePointOfUse
        -- Every controlled answer also accepts a word the vocabulary does not
        -- have yet. The word is written immediately and marked proposed. A
        -- vocabulary that can only grow through a curation screen stops growing,
        -- and what stops with it is the labelling.

    @guarantee ACompoundVocabularyEditsOneWordAtATime
        -- When one property carries several vocabulary words, editing and
        -- autocomplete act on the word beside the caret. Choosing `memoria` in
        -- `diseño, mem, soberanía` preserves the other two answers. The whole
        -- stored value remains visible and can still be rewritten deliberately.

    @guarantee AnUnclassifiedPageReadsAsANote
        -- A page with no confirmed semantic type reads as a note. That reading
        -- is not stored: no assignment is created, no participant is credited
        -- with a decision they did not make, and the difference between "this is
        -- a note" and "nobody has classified this yet" stays askable — which is
        -- the same distinction between suggested and confirmed that governs
        -- every other assignment here.

    @guarantee AVocabularyWordIsAnOrdinaryPage
        -- A word of the vocabulary is reached at the page that bears its name.
        -- Not a namespace, not a settings screen: the page `proyecto`, which one
        -- can write on, link to, and read the history of, exactly like any
        -- other. A Concept therefore has a corpus Page as its identity; it is
        -- never a second record beside that page. The corpus already half
        -- believes it — `Memex` arrived as both a tag and a page.
        --
        -- What that page presents beyond what is written on it is every page
        -- that declares the concept, links to it, or merely mentions its name
        -- as a potential undeclared link. The list is derived and standing, in
        -- the same way backlinks are, and includes a search bounded to exactly
        -- that list. Neither the listing nor the search is copied into Markdown.

    @guarantee TechnicalKeysAndCorpusWordsSpeakDifferentLanguages
        -- Stable program roles are named in English; the words a participant
        -- reads and writes as values belong to the corpus and are Spanish:
        -- `person`, `concept` and `daily_log` govern `persona`, `concepto` and
        -- `bitácora`. Existing forms such as `public:: false` remain legible and
        -- are not silently migrated. Normalising them is a later, explicit,
        -- previewable migration governed by VocabularyChangesAreMigrationsAndNotRewrites.

    @guarantee APropertyKeyIsAPageToo
        -- `status` is not only a word in a header: it is the page `status`,
        -- where what it means, what it admits and who approved those values can
        -- be written and read. The corpus carries 231 distinct keys and not one
        -- of them has anywhere to be defined, which is why nobody has defined
        -- them.
        --
        -- Reached flat, with no prefix, exactly like a value. A `Property:`
        -- namespace would keep keys from colliding with notes, and Vera declines
        -- it for the reason it declines it for values: a namespace makes the
        -- vocabulary a separate country one has to travel to, and the whole
        -- point is that a word of the vocabulary is somewhere you already go.

    @guarantee AVocabularyPageIsBornFurnished
        -- Pressing a vocabulary word that has no page creates it, like pressing
        -- any other name. What it creates is not blank: the page arrives already
        -- carrying what the graph knows about that word — every page it
        -- classifies or defines, and a search bounded to exactly those — and
        -- room to write above it.
        --
        -- This is what makes creating on a press safe here. The objection to it
        -- was hundreds of empty pages nobody asked for; a page that answers
        -- «what is a proyecto in this corpus» the moment it exists is not empty,
        -- it is the shortest useful page in Vera. What stays thin is its
        -- Markdown file, which holds only what was typed, because the listing
        -- and the search are derived and are rebuilt from the graph. A word with
        -- nothing written on it projects as a title and nothing else, and that
        -- is honest: nobody has written it yet.
        --
        -- Which words deserve to be written stops being a question about empty
        -- files and becomes a matter for the librarian's round — «forty pages
        -- answer with this word and nobody has said what it means» is a
        -- decision someone can take, and an empty file is not.

    @guarantee APageGathersEveryRoleItsNamePlays
        -- One name, one page, however many jobs that name has. A page whose
        -- title is also a property key and also a value shows all of it: what
        -- was written there, the pages carrying that property, the pages
        -- answering with that value, and what links to it. Each part says which
        -- it is and none replaces the others.
        --
        -- No role wins, and that is the decision. Making the property page
        -- shadow the note would lose writing to a naming coincidence; making the
        -- note shadow the property would hide governance behind a word someone
        -- happened to use as a title. Today two names in the corpus are in this
        -- position — `Home` and `chatgpt-prompt` — and both are better read as
        -- two answers than as one that had to win.
        --
        -- It is also what the corpus already expects. A page is where everything
        -- about a name accumulates: that is what backlinks have always been, and
        -- this is the same rule applied to the vocabulary.

    @guarantee TheSameQuestionsOpenEveryPage
        -- Every page is asked what it is, what it is about, when it was written
        -- and when it was last touched — in that order, present even when
        -- unanswered. A header whose shape depends on what happens to be filled
        -- in cannot be learned, and an absent question reads as a question that
        -- does not apply rather than one nobody has answered.
}

------------------------------------------------------------
-- Dónde se declara todo esto
------------------------------------------------------------

-- La ontología se escribe en dos páginas, y son dos porque son dos preguntas.
--
-- Había una sola —«Ontología»— con todo dentro: los tipos, unas propiedades
-- sueltas, el vocabulario de relaciones y las reglas de gobierno. Se parte porque
-- las dos preguntas que contiene se hacen en momentos distintos y se responden
-- mirando cosas distintas:
--
--   - Qué propiedades hay y de qué clase es cada una. Un `fecha` no se rellena
--     como un `doi`, y un `concepto` que nombra otra página no se lee como texto
--     suelto. Sin decirlo en alguna parte, toda propiedad es una caja de texto y
--     quien escribe tiene que acordarse de todo.
--
--   - Qué clases de cosa hay y qué propiedades constituyen a cada una. Es lo que
--     permite que una página diga qué le falta en vez de esperar a que alguien se
--     acuerde.
--
-- Las dos se escriben con las herramientas de siempre: un bloque por cosa, con
-- sus propiedades colgando. Que la ontología de las propiedades esté escrita con
-- propiedades no es un juego: es lo que hace que se edite, se busque, se enlace y
-- se versione como todo lo demás, en vez de ser un formato aparte que sólo
-- entiende el programa.
contract TheOntologyIsWrittenWhereItCanBeRead {
    declare: (page: core/Page) -> Ontology

    @invariant OneQuestionPerPage
        -- Una página declara las propiedades, otra los objetos y otra los tipos
        -- de relación. Juntarlas
        -- obligaba a leer la mitad que no importaba para encontrar la que sí, y
        -- era el motivo por el que casi nada llegaba a declararse.

    @invariant AnEdgeMayBeWrittenBeforeItIsTyped
        -- La relación concreta no es su tipo. Tiene identidad, extremos y
        -- contenido propio aunque el selector siga en «sin tipificar». Elegir
        -- un tipo después clasifica la arista; nunca habilita su escritura.

    @invariant DomainAndRangeAdviseAndNeverRefuse
        -- Dominio y rango ordenan el vocabulario ofrecido y hacen visible una
        -- discrepancia. No impiden crear ni editar una relación: puede estar
        -- equivocada la arista, pero también puede estar incompleta la ontología.

    @invariant ADeclarationIsABlockThatCarriesProperties
        -- Se lee como declaración un bloque con propiedades colgando; la prosa
        -- que lo rodea no lleva ninguna y por eso no declara nada. Así la página
        -- no necesita apartados con nombres mágicos y quien la escribe puede
        -- ordenarla como quiera, incluida la parte donde explica por qué decidió
        -- lo que decidió.

    @invariant EachPropertySaysItsOwnRole
        -- Qué papel de los que el código conoce cumple una propiedad se declara
        -- pegado a ella —`papel:: kind` bajo el bloque `tipo`— y no en una lista
        -- aparte. Es donde alguien lo va a buscar: quien se pregunta qué es
        -- `tipo` mira `tipo`.

    @invariant TheShapeIsSaidAndNeverEnforced
        -- Declarar describe y no obliga. Vera no rechaza una página por llevar
        -- una propiedad sin declarar, ni por rellenarla de otra manera, ni por
        -- que le falte lo que su clase espera. Una memoria que exigiera la ficha
        -- llena obligaría a saber el final antes de empezar, y casi nada de lo
        -- que uno escribe nace completo.

    @invariant WhatIsUndeclaredIsCountedAndNotBlamed
        -- Lo que el corpus usa sin declarar se enseña, con cuántas veces. No es
        -- un reproche: casi todo lo que hay en un corpus vivo llegó sin pedir
        -- permiso, y declarar es una decisión que se toma después. Está para que
        -- esa decisión se pueda tomar mirando en vez de acordándose.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Which ontology changes may an agent curator apply without prior human confirmation?"
open question "When processing resolves a link, does the title it found belong in the block as text, in a property of the page, or in a record beside the link that the block never sees?"
open question "What does processing do with an address it cannot reach — say nothing, propose the link as dead, or leave a standing question to retry later, given that unreachable today and gone for ever look identical from here?"
-- Las clases de campo distinguen al menos texto, número, fecha, enlace interno,
-- URL externa, sí/no y una de. La lista se mantiene corta: una lista larga es
-- una lista de validaciones que alguien tendría que escribir y mantener.
open question "¿Hace falta alguna clase de campo más —duración, cantidad con unidad, rango de fechas— o lo que parece faltar se resuelve declarando los valores conocidos de «una de»?"

open question "What happens when two composed semantic types define incompatible properties or lifecycles?"
open question "Are semantic types assigned to pages and blocks equally, or do some types permit only one target kind?"
-- Contestada: vive como página del corpus, la que lleva su nombre, y lo que
-- muestra de más es derivado. Ver @guarantee AVocabularyWordIsAnOrdinaryPage.

-- Lo que abre gobernar el front matter con controles. Está aquí y no en una
-- lista aparte porque son decisiones sin tomar, no trabajo sin hacer.
open question "Cuando una propiedad ya escrita no admite el dominio que después se le declaró — el `type` cuyo valor es `\": \"`, el que empaqueta cinco tipos con barras — ¿se enseña como discrepancia junto a su control, se deja sólo como texto, o se propone una migración por valor?"
open question "¿Quién decide que una propiedad rige en todo el grafo y no en un tipo: se declara así, o se infiere de que la usan páginas de tipos distintos?"
open question "Una propiedad definida como requerida por un tipo, ¿qué hace en las páginas de ese tipo que no la tienen — se enseña vacía y exigible, se propone un valor, o requerida sólo significa que no se puede borrar una vez puesta?"
open question "El valor de una propiedad que nombra vocabulario, ¿tiene que ser el título de una página existente, o puede nombrar una que todavía no se ha escrito, como hace una cita?"
open question "Can a relation be asserted between two entities whose types the relation's domain and range do not admit — refused, allowed with a warning, or allowed because the ontology is likely to be the thing that is wrong?"
open question "Which relations are editable and which are necessarily derived from links, authorship, operations or external imports, given that a derived relation edited by hand would contradict the very thing it derives from?"
