-- allium: 3
-- core.allium

-- Scope: Participation, provenance, semantic graph changes and personal publishing
-- Terminology: Vera is the system; a memory is one human's sovereign corpus;
--   Graph is the structural domain model of that memory. A library is a
--   bibliographic region or integration within it, not a synonym for the whole.
-- Includes: Human and agent participants, authenticated submissions, revisions,
--   canonical human voice evidence, public/private page visibility, and projection
--   of public graph pages as a personal website
-- Excludes:
--   - Storage engine, file layout and database schema
--   - Network protocol and client implementation
--   - Graph visual layout (specified separately, informed by logseq-constel)
--   - Authentication mechanism
--   - Git commit and deployment mechanics

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value OriginEvidence {
    reference: String
    captured_at: Timestamp
}

value PageReference {
    -- El título gobierna identidad, navegación, backlinks y renombre; el rótulo
    -- permite que la referencia se lea como parte natural de una frase.
    target_title: String
    label: String
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum ParticipantKind { human | agent }
enum ParticipantStatus { active | suspended }
-- Por qué vía llegó a Vera lo que un participante produjo.
--
-- `walked` es el cuarto y el que menos se parece a los otros tres: no se tecleó,
-- no se dijo y no lo generó nadie más. Es lo que alguien produjo andando por el
-- corpus, y entra porque hay un texto de Vera que ninguno de los otros tres
-- explicaría — el testimonio de un cruce, que dice cómo se pasó de una página a
-- la siguiente (ver trail.allium).
--
-- Admitirlo es afirmar que caminar es producir. La alternativa era que Vera
-- escribiera ese testimonio de su cuenta, y entonces habría texto en el corpus
-- que ningún participante puso: es exactamente lo que la autoría por bloque
-- existe para impedir.
-- Cómo se produjo lo que un bloque lleva dentro.
--
-- `drawn` es de la misma clase que `authenticated_voice` y por la misma razón:
-- son las dos formas en que algo llega al corpus con denominación de origen
-- humana. Una grabación prueba que alguien habló; un trazo con su presión prueba
-- que alguien lo hizo con la mano sobre una pantalla. En un corpus donde también
-- escriben máquinas, eso no es un detalle de cómo entró el contenido: es lo que
-- distingue lo que salió de una persona. Ver hand-drawing.allium.
enum ContributionChannel { typed_text | authenticated_voice | agent_generation | import | walked | drawn }
enum Visibility { private | public }
-- Los enlaces Markdown siguen derivados del contenido. Las conectivas, en
-- cambio, son escritura de la arista y por eso tienen cambios propios.
enum ChangeKind {
    create_page | rename_page | set_page_visibility | recover_page_origin | remove_page |
    create_block | edit_block | move_block | remove_block |
    set_block_gloss |
    create_crossing | edit_crossing |
    set_property | remove_property
}
enum SubmissionStatus { submitted | accepted | rejected }

------------------------------------------------------------
-- Entities
------------------------------------------------------------

entity Participant {
    name: String
    kind: ParticipantKind
    status: ParticipantStatus
    memberships: Membership with participant = this
}

entity Graph {
    name: String
    owner: Participant
    memberships: Membership with graph = this
    pages: Page with graph = this
}

entity Membership {
    graph: Graph
    participant: Participant
    status: ParticipantStatus
}

entity Page {
    graph: Graph
    title: String
    visibility: Visibility
    blocks: Block with page = this
    revisions: Revision with page = this

    -- Dos títulos que sólo difieren en mayúsculas o acentos nombran la misma
    -- página. El corpus escribe [[LogSeq]] y [[Logseq]] para una sola, y
    -- resolverlas por separado partiría el grafo en pedazos falsos.
    title_key: title_key(title)

    -- Cuándo esta página empezó a existir en Vera. Sale del registro, no se
    -- edita, y para una página importada dice el día de la importación: es
    -- cierto sobre Vera y no sobre lo que la página cuenta.
    created_at: Timestamp

    -- Cuándo se escribió, según el corpus del que vino, cuando se pudo
    -- recuperar. Nulo cuando no se pudo.
    --
    -- Dos fuentes verificables la pueblan: el nombre del archivo de un diario y
    -- la primera incorporación del archivo al historial Git. La fecha del diario
    -- gana para sus páginas; Git cubre las páginas ordinarias que tienen historia.
    --
    -- Lo demás que se midió y se descartó, para que no se vuelva a medir: la
    -- fecha de modificación del archivo es el rastro de una sincronización —804
    -- archivos comparten mes— y no de haber escrito nada; y la propiedad `date::`
    -- del corpus dice cuándo pasó lo que la página cuenta, no cuándo se escribió
    -- la página, con valores como `2012` y `2003`. El historial Git conserva una
    -- fecha portable y verificable; el nacimiento local del archivo no se usa
    -- porque depende de esta copia del disco.
    --
    -- Se guarda aparte de created_at y no lo sobreescribe porque son dos hechos
    -- distintos con dos procedencias distintas, y colapsarlos pierde lo único
    -- que permite volver sobre ellos: un importador que mañana lea una fuente
    -- de fechas mejor no sabría a qué páginas aplicarla.
    origin_created_at: Timestamp?

    -- La fecha que se enseña, y si lo que se enseña es un hecho o un techo.
    -- Sin fecha de origen lo único que se sabe es que la página no se escribió
    -- después de entrar, y enseñar eso como si fuera el día en que se escribió
    -- afirma algo que nadie comprobó.
    authored_at: origin_created_at ?? created_at
    authored_at_is_ceiling: origin_created_at = null

    -- Cuándo se tocó por última vez, derivado del registro. No se almacena: dos
    -- copias del mismo dato son dos ocasiones de discrepar, y la historia ya lo
    -- sabe.
    last_edited_at: last_revision_time(revisions)
}

entity PersonalSite {
    graph: Graph
    owner: Participant
    title: String
    canonical_domain: String
    -- Antes de la primera publicación todavía no hay portada. La primera página
    -- publicada puede ocuparla en el mismo gesto; después siempre nombra una
    -- publicación vigente del propio sitio.
    entry_point: Page?
    -- Cada superficie decide si su lectura anónima permite abrir desde la
    -- viñeta la historia pública trazable de sus bloques.
    transparent_block_traceability: Boolean
    publications: Publication with site = this
}

-- A block's stable_id is the identity that survives editing and moving. The distilled
-- Logseq reference calls the same concept KnowledgeBlock.stable_address; Vera's own
-- name is stable_id and the reference's guarantees apply to it unchanged.
entity Block {
    stable_id: String
    -- Un bloque pertenece a un solo outline. Las páginas y las relaciones usan
    -- el mismo bloque y el mismo editor; estas dos claves son una unión
    -- exclusiva, no dos copias del contenido.
    page: Page?
    crossing_id: String?
    parent: Block?
    position: Integer
    content: String
    revisions: Revision with block = this
    children: Block with parent = this
}

-- page and block name the subject of the change, which is what a revision is attributed
-- to. The remaining fields carry the payload each kind needs. Which fields a given kind
-- requires is specified in change-application.allium, not restated here.
entity Change {
    kind: ChangeKind
    page: Page?
    block: Block?
    -- Identidad y extremos de una conectiva persistente. Se expresan aquí como
    -- identificadores porque la entidad semántica vive en trail.allium.
    crossing_id: String?
    from_page: Page?
    to_page: Page?
    term: String?
    content: String?
    parent: Block?
    position: Integer?
    -- Una identidad propuesta por quien envía. Sólo la usa la importación, para
    -- adoptar los identificadores que el corpus ya traía en vez de inventar otros
    -- y romper las referencias que existían fuera de Vera.
    stable_id: String?
    title: String?
    visibility: Visibility?
    property_key: String?
    property_value: String?
    -- La fecha que el corpus de origen sabía. Como stable_id, sólo la usa la
    -- importación, y por la misma razón: es un hecho que ya existía y que Vera
    -- adopta en vez de inventar uno peor.
    origin_created_at: Timestamp?
}

entity Submission {
    graph: Graph
    origin_id: String
    submitted_by: Participant
    change: Change
    channel: ContributionChannel
    evidence: OriginEvidence?
    submitted_at: Timestamp
    status: SubmissionStatus
    rejection_reason: String?
}

entity Revision {
    graph: Graph
    page: Page?
    block: Block?
    crossing_id: String?
    change: Change
    authored_by: Participant
    channel: ContributionChannel
    evidence: OriginEvidence?
    recorded_at: Timestamp

    origin_is_canonical: channel = authenticated_voice and evidence != null
}

-- Properties are canonical content: the imported corpus carries them on almost every
-- page and Vera's queries select on them. What a property may mean is governed by
-- controlled-ontology.allium; that a page or block carries one is governed here.
entity PropertyAssignment {
    graph: Graph
    page: Page?
    block: Block?
    key: String
    value: String
}

entity Publication {
    site: PersonalSite
    page: Page
    -- La revisión vigente cuando se abrió la vida pública de la página. No
    -- congela la publicación: marca la frontera que separa el pasado privado.
    first_revision: Revision
    path: String
    published_at: Timestamp
    public_revisions: page.revisions where recorded_at >= first_revision.recorded_at

    -- Quién publicó, escrito y no derivado. Es hoy el dueño del sitio, pero un
    -- sitio puede cambiar de manos, y entonces leer la autoría desde el dueño de
    -- ahora haría decir al registro que publicó alguien que no estaba. «Quién
    -- publicó esto y cuándo» es exactamente la clase de pregunta que Vera existe
    -- para contestar, así que se guarda en el momento en que la respuesta consta.
    published_by: Participant
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule AcceptParticipantSubmission {
    when: ParticipantSubmits(participant, graph, origin_id, change, channel, evidence?)

    let membership = Membership{graph, participant}

    requires: exists membership
    requires: membership.status = active
    requires: channel != authenticated_voice or evidence != null
    requires: not exists Submission{graph: graph, origin_id: origin_id}

    ensures:
        let submission = Submission.created(
            graph: graph,
            origin_id: origin_id,
            submitted_by: participant,
            change: change,
            channel: channel,
            evidence: evidence,
            submitted_at: now,
            status: accepted,
            rejection_reason: null
        )
        Revision.created(
            graph: graph,
            -- A change to a block is attributed to the page that block sits on, so
            -- a page's history reads whole rather than only its page-level edits.
            page: subject_page(change),
            block: change.block,
            change: change,
            authored_by: participant,
            channel: channel,
            evidence: evidence,
            recorded_at: now
        )
        SubmissionAccepted(submission: submission)
}

rule PublishVisiblePage {
    when: PublishPage(participant, site, page, path)

    let membership = Membership{graph: page.graph, participant: participant}

    requires: exists membership
    requires: membership.status = active
    requires: participant.kind = human
    requires: site.owner = participant
    requires: site.graph = page.graph
    requires: page.visibility = public

    ensures: Publication.created(
        site: site,
        page: page,
        path: path,
        published_at: now,
        published_by: participant
    )
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant VoiceCanonicalityRequiresEvidence {
    for revision in Revisions:
        revision.origin_is_canonical implies revision.evidence != null
}

invariant PrivatePagesAreNeverPublished {
    for publication in Publications:
        publication.page.visibility = public
}

invariant OnlySiteOwnerPublishes {
    for publication in Publications:
        publication.site.owner.kind = human
}

invariant PublicationBelongsToSiteGraph {
    for publication in Publications:
        publication.page.graph = publication.site.graph
}

invariant SiteEntryPointIsPublishedInItsOwnGraph {
    for site in PersonalSites:
        site.entry_point != null implies
            site.entry_point.graph = site.graph and
            exists Publication{site: site, page: site.entry_point}
}

invariant PublicationRecordsItsHumanPublisher {
    for publication in Publications:
        publication.published_by.kind = human
}

invariant PublicationBeginsAtARevisionOfItsPage {
    for publication in Publications:
        publication.first_revision.page = publication.page
}

-- Dos publicaciones en la misma dirección no son dos: son una que perdió a la
-- otra. @invariant CanonicalAddress de personal-site-projection.allium descansa
-- en esto, porque una URL canónica que nombra a dos páginas no es canónica.
invariant PublicationPathIsUniqueWithinSite {
    for a in Publications:
        for b in Publications:
            a != b implies a.site != b.site or a.path != b.path
}

invariant RevisionParticipantBelongsToGraph {
    for revision in Revisions:
        exists Membership{graph: revision.graph, participant: revision.authored_by}
}

invariant EveryBlockHasExactlyOneOutlineOwner {
    for block in Blocks:
        (block.page != null) != (block.crossing_id != null)
}

invariant ParentAndChildShareTheirOutlineOwner {
    for block in Blocks:
        block.parent != null implies
            block.parent.page = block.page and
            block.parent.crossing_id = block.crossing_id
}

invariant EveryMemoryHasOneHumanOwner {
    for graph in Graphs:
        graph.owner.kind = human and
        graph.owner.status = active and
        exists Membership{
            graph: graph,
            participant: graph.owner,
            status: active
        }
}

-- A page title is what a [[reference]] names, so two pages sharing one would make
-- every link to it ambiguous.
invariant PageTitleIsUniqueWithinGraph {
    for a in Pages:
        for b in Pages:
            a != b implies a.graph != b.graph or a.title_key != b.title_key
}

invariant BlockStableIdentityIsUnique {
    for a in Blocks:
        for b in Blocks:
            a != b implies a.stable_id != b.stable_id
}

invariant SubmissionOriginIsUniqueWithinGraph {
    for a in Submissions:
        for b in Submissions:
            a != b implies a.graph != b.graph or a.origin_id != b.origin_id
}

invariant BlockParentBelongsToSamePage {
    for block in Blocks:
        block.parent != null implies block.parent.page = block.page
}

invariant PropertyTargetsOneSubject {
    for assignment in PropertyAssignments:
        (assignment.page != null or assignment.block != null) and
        not (assignment.page != null and assignment.block != null)
}

invariant PropertyKeyIsUniquePerSubject {
    for a in PropertyAssignments:
        for b in PropertyAssignments:
            a != b and a.key = b.key implies a.page != b.page or a.block != b.block
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor VeraParticipant {
    within: Graph
    identified_by: Participant where Membership{participant: this, graph: within}.status = active
}

actor PersonalSiteOwner {
    within: PersonalSite
    identified_by: Participant where this = within.owner
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface GraphParticipation {
    facing participant: VeraParticipant
    context graph: Graph

    exposes:
        graph.name
        graph.pages

    provides:
        ParticipantSubmits(participant, graph, origin_id, change, channel, evidence?)

    @guarantee IdempotentSubmission
        -- The submitting participant names each change with an origin_id. Resubmitting
        -- an origin_id the graph has already accepted changes nothing.

    @guarantee EqualMutationPath
        -- Human and agent participants submit changes through this same boundary.
        -- Participant kind does not grant a privileged write path.

    @guarantee AttributedHistory
        -- Every accepted change produces a revision attributed to its participant
        -- and contribution channel.
}

surface PersonalSitePublication {
    facing owner: PersonalSiteOwner
    context site: PersonalSite

    exposes:
        site.title
        site.canonical_domain
        site.entry_point
        site.transparent_block_traceability
        site.publications

    provides:
        PublishPage(owner, site, page, path) when page.visibility = public

    @guarantee HumanPublicationAuthority
        -- Only the human owner of the personal site authorizes publication.
        -- Agents may prepare public-ready pages but cannot publish them.

    @guarantee StablePublicAddress
        -- A publication has an explicit path under the site's canonical domain,
        -- independent of the technology used to render or deploy the site.
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

deferred ChangeApplication.apply       -- see: change-application.allium
deferred GraphNavigation.traverse      -- see: graph-navigation.allium
deferred GraphNavigation.present       -- see: graph-navigation.allium
deferred OfflineSubmission.reconcile   -- see: offline-reconciliation.allium
deferred PersonalSiteProjection.render -- see: personal-site-projection.allium
deferred ContentMedia.present           -- see: content-media.allium
deferred WorkspaceInterface.present     -- see: workspace-interface.allium
deferred ControlledOntology.curate      -- see: controlled-ontology.allium
deferred BibliographicIntegration.sync  -- see: bibliographic-integration.allium
deferred IdentityAccess.authorize        -- see: identity-access.allium
deferred Trail.compose                   -- see: trail.allium
deferred BlockGloss.annotate             -- see: block-gloss.allium

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

-- The smallest change vocabulary is now settled in ChangeKind and applied in
-- change-application.allium. What remains open is whether media attachment and
-- ontology assignment are change kinds or separate submission paths.
open question "Are attaching media and assigning a semantic type change kinds, or do they reach the graph by their own paths?"
open question "Which participant and which precondition produce a rejected submission, given that no rule sets that status today?"
open question "Can a participant revise another participant's contribution without preserving both voices visibly?"
open question "When the exceptional case occurs and two devices changed the same block offline, which changes may Vera merge automatically and which require explicit human resolution?"
open question "Are pages and blocks sufficient as Vera's canonical content model, or are typed nodes needed?"
open question "Which historical metadata and asset behaviours from herbertspencer.net must Vera preserve exactly?"
