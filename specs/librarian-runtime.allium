-- allium: 3
-- librarian-runtime.allium

-- Scope: ejecución embebida y gobernada de la bibliotecaria de una Vera.
-- Includes: constitución, configuración de inferencia por referencia, ciclo de
--   vida, solicitudes, ronda diaria, recibos y coexistencia con un puente externo.
-- Excludes: custodia material del secreto, semántica de cada modelo y herramientas
--   mutantes distintas de la respuesta ordinaria del agente de biblioteca.

use "./core.allium" as core
use "./agent-manifest.allium" as manifests
use "./agent-conversation.allium" as conversations
use "./owner-librarian-harness.allium" as harnesses

enum LibrarianRunKind { request | routine }
enum LibrarianRunState { running | completed | failed }
enum LibrarianRuntimePermission { read_request_context | reply | daily_round }
enum FormativePractice { reading | selection | interpretation | comparison | synthesis | conclusion }
enum DialecticGateStatus { open | responding | fulfilled | bypassed }

entity LibrarianRuntimeConfiguration {
    librarian: harnesses/OwnerLibrarian
    enabled: Boolean
    model_id: String?
    endpoint: String?
    secret_reference: String?
    permissions: List<LibrarianRuntimePermission>
    dialectic_enabled: Boolean
    routine_enabled: Boolean
    routine_hour: Integer
    routine_timezone: String
    updated_by: core/Participant
    updated_at: Timestamp
}

entity LibrarianDialecticGate {
    librarian: harnesses/OwnerLibrarian
    conversation: conversations/Conversation
    opening_request: conversations/ConversationRequest
    practice: FormativePractice
    challenge: String
    status: DialecticGateStatus
    closing_request: conversations/ConversationRequest?
    opened_at: Timestamp
    closed_at: Timestamp?
}

entity LibrarianRuntimeRun {
    id: String
    librarian: harnesses/OwnerLibrarian
    manifest: manifests/AgentManifest?
    kind: LibrarianRunKind
    request_id: String?
    model_id: String
    status: LibrarianRunState
    started_at: Timestamp
    finished_at: Timestamp?
    output: String?
    error: String?
}

actor LibrarianOwner {
    identified_by: core/Participant where this.kind = human and this.status = active
}

rule OwnerConfiguresEmbeddedRuntime {
    when: ConfigureLibrarianRuntime(owner, librarian, enabled, model_id, endpoint, secret_reference, permissions, dialectic_enabled, routine_enabled, routine_hour, routine_timezone)
    requires: librarian.owner = owner
    requires: not enabled or model_id != null
    requires: routine_hour >= 0 and routine_hour <= 23
    requires: not enabled or (permissions.contains(read_request_context) and permissions.contains(reply))
    requires: not routine_enabled or permissions.contains(daily_round)
    ensures: LibrarianRuntimeConfiguration.created(
        librarian: librarian,
        enabled: enabled,
        model_id: model_id,
        endpoint: endpoint,
        secret_reference: secret_reference,
        permissions: permissions,
        dialectic_enabled: dialectic_enabled,
        routine_enabled: routine_enabled,
        routine_hour: routine_hour,
        routine_timezone: routine_timezone,
        updated_by: owner,
        updated_at: now
    )
}

rule LibrarianOpensAFormativeThreshold {
    when: OpenDialecticGate(librarian, configuration, request, practice, challenge)
    requires: configuration.librarian = librarian
    requires: configuration.enabled
    requires: configuration.dialectic_enabled
    requires: request.conversation.agent = librarian.librarian
    requires: request.status = working
    requires: delegates_formative_practice(request, practice)
    requires: challenge != ""
    requires: not exists LibrarianDialecticGate{conversation: request.conversation, status: open}
    requires: not exists LibrarianDialecticGate{conversation: request.conversation, status: responding}
    ensures:
        request.status = answered
        request.finished_at = now
        conversations/AgentReply.created(
            request: request,
            answered_by: librarian.librarian,
            text: challenge,
            written_block: null,
            created_at: now
        )
        LibrarianDialecticGate.created(
            librarian: librarian,
            conversation: request.conversation,
            opening_request: request,
            practice: practice,
            challenge: challenge,
            status: open,
            closing_request: null,
            opened_at: now,
            closed_at: null
        )
}

rule HumanContributesAcrossTheThreshold {
    when: ContributeAcrossDialecticGate(human, gate, request)
    requires: gate.conversation.human = human
    requires: gate.status = open
    requires: request.conversation = gate.conversation
    requires: request.asked_by = human
    requires: request.text != ""
    ensures:
        gate.status = responding
        gate.closing_request = request
}

rule HumanExplicitlyBypassesTheThreshold {
    when: BypassDialecticGate(human, gate, request)
    requires: gate.conversation.human = human
    requires: gate.status = open
    requires: request.conversation = gate.conversation
    requires: request.asked_by = human
    ensures:
        gate.status = responding
        gate.closing_request = request
}

rule LibrarianCompletesTheDialectic {
    when: CompleteDialecticGate(librarian, gate, final_reply, bypassed)
    requires: gate.librarian = librarian
    requires: gate.status = responding
    requires: gate.closing_request != null
    requires: final_reply.request = gate.closing_request
    requires: final_reply.answered_by = librarian.librarian
    ensures:
        if bypassed:
            gate.status = bypassed
        else:
            gate.status = fulfilled
        gate.closed_at = now
}

rule FailedDialecticCompletionReopensTheThreshold {
    when: ReopenDialecticGateAfterFailure(librarian, gate)
    requires: gate.librarian = librarian
    requires: gate.status = responding
    ensures:
        gate.status = open
        gate.closing_request = null
}

rule EmbeddedRuntimeAnswersOneClaimedRequest {
    when: RunLibrarianRequest(configuration, request_id)
    requires: configuration.enabled
    requires: configuration.model_id != null
    requires: configuration.permissions.contains(read_request_context)
    requires: configuration.permissions.contains(reply)
    ensures: LibrarianRuntimeRun.created(
        id: generated_id,
        librarian: configuration.librarian,
        manifest: active_manifest(configuration.librarian.librarian),
        kind: request,
        request_id: request_id,
        model_id: configuration.model_id,
        status: completed,
        started_at: now,
        finished_at: now,
        output: generated_reply,
        error: null
    )
}

rule OwnerRunsTheDailyRound {
    when: RunLibrarianRoutine(owner, configuration)
    requires: configuration.librarian.owner = owner
    requires: configuration.enabled
    requires: configuration.permissions.contains(daily_round)
    ensures: LibrarianRuntimeRun.created(
        id: generated_id,
        librarian: configuration.librarian,
        manifest: active_manifest(configuration.librarian.librarian),
        kind: routine,
        request_id: null,
        model_id: configuration.model_id,
        status: completed,
        started_at: now,
        finished_at: now,
        output: generated_round,
        error: null
    )
}

invariant SecretsAreReferencesNotValues {
    for configuration in LibrarianRuntimeConfigurations:
        configuration.secret_reference = null or
        not configuration.secret_reference.contains("Bearer ")
}

invariant OneRuntimeConfigurationPerOwnerLibrarian {
    for a in LibrarianRuntimeConfigurations:
        for b in LibrarianRuntimeConfigurations:
            a.librarian = b.librarian implies a = b
}

surface LibrarianRuntimeAdministration {
    facing owner: LibrarianOwner
    context configuration: LibrarianRuntimeConfiguration where configuration.librarian.owner = owner

    exposes:
        configuration.librarian
        configuration.enabled
        configuration.model_id
        configuration.endpoint
        configuration.secret_reference
        configuration.permissions
        configuration.dialectic_enabled
        configuration.routine_enabled
        configuration.routine_hour
        configuration.routine_timezone
        for run in LibrarianRuntimeRuns where librarian = configuration.librarian:
            run.kind
            run.model_id
            run.status
            run.started_at
            run.finished_at
            run.output
            run.error

    provides:
        ConfigureLibrarianRuntime(owner, configuration.librarian, enabled, model_id, endpoint, secret_reference, permissions, dialectic_enabled, routine_enabled, routine_hour, routine_timezone)
        RunLibrarianRoutine(owner, configuration)

    @guarantee RuntimeIdentityIsTheConstitutedLibrarian
        -- La bibliotecaria responde con su participante. Cotito puede seguir
        -- operando por el puente externo, pero nunca firma como Lucienne.

    @guarantee OneClaimHasOneWinner
        -- El runtime embebido y un puente externo pueden coexistir. La primera
        -- reclamación atómica gana y la otra recibe que el turno ya no está en cola.

    @guarantee ActivationRequiresAnExplicitHumanAct
        -- Constituir una bibliotecaria o migrar una instalación no inicia un
        -- modelo ni una rutina. La persona elige modelo, permisos y activación.

    @guarantee RoutinesBeginDisabled
        -- Una ronda automática nace apagada y también puede ejecutarse a mano.

    @guarantee LargePagesAndManifestsDoNotOverflowTheModelContext
        -- La solicitud y el manifiesto permanecen íntegros como recibos durables,
        -- pero el prompt recibe proyecciones acotadas que priorizan identidad,
        -- gobierno, foco, estructura y pasajes pertinentes. Una página o
        -- constitución grande no hace fallar una pregunta breve.

    @guarantee ModelFailuresDoNotPersistThePrompt
        -- Un fallo local registra un diagnóstico acotado. La línea de comandos,
        -- que contiene el prompt y su contexto privado, nunca queda en el recibo.

    @guarantee RoutinesOnlyReportOperationalEvidence
        -- Una ronda no encarga al modelo inventar diagnósticos a partir de
        -- conteos. Sin violaciones observadas responde SIN_NOVEDAD; con ellas
        -- enumera únicamente los controles que Vera comprobó y sus detalles.

    @guarantee EveryRunLeavesPublicOperationalEvidence
        -- Vera conserva modelo, manifiesto, comienzo, término, estado, salida o
        -- error. No conserva razonamiento privado ni el valor del secreto.
}

actor LibrarianConversationHuman {
    identified_by: core/Participant where this.kind = human and this.status = active
}

surface LibrarianDialecticConversation {
    facing human: LibrarianConversationHuman
    context gate: LibrarianDialecticGate where conversation.human = human

    exposes:
        gate.practice
        gate.challenge
        gate.status
        gate.opening_request
        gate.closing_request

    provides:
        ContributeAcrossDialecticGate(human, gate, request) when gate.status = open
        BypassDialecticGate(human, gate, request) when gate.status = open

    @guarantee FinalAnswerWaitsForAContributionOrExplicitBypass
        -- El desafío puede orientar o reducir la consigna, pero no contiene
        -- subrepticiamente el trabajo final. El harness sólo permite completarlo
        -- después de una tentativa humana o de un bypass visible y deliberado.

    @guarantee OperationalRequestsRemainDirect
        -- Buscar, citar, verificar, recuperar, ordenar, transcribir, enlazar,
        -- completar metadatos, formatear o ejecutar una decisión ya tomada no
        -- abre un umbral. Una fuente identificable tampoco debe quedar detrás de
        -- una pregunta formativa.

    @guarantee AClueCountsAsContribution
        -- Una pista, hipótesis, fuente o criterio ya aportado basta para ayudar
        -- directamente. La persona no tiene que repetir esa contribución en la
        -- forma que prefiera el agente.

    @guarantee DeterminedWorkComesBeforeAQuestion
        -- Si una solicitud mezcla recuperación factual y juicio, el agente
        -- completa primero la parte determinada. Puede formular como máximo una
        -- pregunta breve sobre la decisión personal restante, sin retener lo ya
        -- encontrado.

    @guarantee MayeuticsIsAnOfferNotAnAccessCondition
        -- Una petición explícita de ejecución directa o la insistencia posterior
        -- cierran la resistencia sin contraseña social, reproche ni otro desafío.

    @guarantee OneOpenThresholdPerConversation
        -- Una conversación no acumula exámenes ni bucles de desafíos. El turno
        -- que responde a un umbral debe recibir una respuesta final.
}
