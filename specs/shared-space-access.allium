-- allium: 3
-- shared-space-access.allium

-- Scope: Human authentication and access to named, delimited parts of one
--   sovereign personal Vera graph
-- Includes: One owner on several devices, passkeys, revocable sessions,
--   invitation capabilities delivered by any channel, guests without Vera,
--   federated Vera identities, public and restricted shared spaces assembled
--   from several criteria and explicit pages, reading, contribution and direct
--   editing
-- Excludes:
--   - Mail, messaging and QR delivery implementation
--   - WebAuthn ceremony and cryptographic storage implementation
--   - Replica synchronisation and continuation after withdrawal
--     (see federated-sharing.allium)
-- Dependencies: Graph, Page, Participant and Membership are governed by
--   core.allium; the single sovereign instance is governed by
--   identity-access.allium

use "./core.allium" as core
use "./identity-access.allium" as identity

------------------------------------------------------------
-- Given
------------------------------------------------------------

given {
    instance: identity/VeraInstance
}

------------------------------------------------------------
-- Value Types
------------------------------------------------------------

value PageSelector {
    property_key: String
    property_value: String
}

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract HumanAccess {
    register_authenticator: (participant: core/Participant, invitation: AccessInvitation?) -> HumanAuthenticator
    authenticate: (authenticator: HumanAuthenticator) -> HumanSession
    end_session: (session: HumanSession) -> HumanSession
    recover_owner: (owner: core/Participant) -> AuthenticatorEnrollment

    @invariant AnAuthenticatorProvesAParticipant
        -- A passkey or a federated Vera assertion proves one stable Participant.
        -- It is not itself that person's identity, and adding another device does
        -- not create another person.

    @invariant OneOwnerMayUseManyDevices
        -- The sovereign owner may register several authenticators. Every one
        -- resolves to the same owner of the same graph.

    @invariant NobodyWithoutProofBecomesTheOwner
        -- Reaching the server, possessing an origin or belonging to its private
        -- network never authenticates a human. A missing or failed proof grants
        -- neither a session nor the owner's authority.

    @invariant TheMachineRemainsTheRootOfRecovery
        -- Losing every authenticator cannot transfer or destroy ownership. A
        -- recovery act performed from the machine that holds the corpus may
        -- authorize a new owner authenticator, and that act is unavailable over
        -- every network surface.

    @invariant ASessionIsNotAnEternalCredential
        -- Successful authentication creates a bounded, revocable session. A
        -- durable relationship or grant may outlive it, but the proof presented
        -- on one visit does not become an everlasting bearer token.
}

contract OwnerAdministration {
    inspect_current_access: (session: HumanSession) -> HumanSession
    inspect_spaces: (owner: core/Participant) -> List<SharedSpace>
    inspect_people: (owner: core/Participant) -> List<AccessGrant>

    @invariant TheOwnerCanAlwaysSeeWhoTheyAre
        -- Every authenticated administration view names the participant, the
        -- method that proved them, the session expiry and the current session.
        -- Authentication is never an invisible ambient property of the browser.

    @invariant SpaceIsThePrimaryAdministrativeObject
        -- Sharing administration begins with named spaces. People and pending
        -- invitations are transversal views of access to those spaces, never a
        -- flat global user-and-role system.

    @invariant InvitationsAreNotPeople
        -- A pending invitation remains a redeemable capability. It appears
        -- separately from stable participants until somebody consumes it.
}

contract SharedSpaceAccess {
    create_space: (owner: core/Participant, name: String, slug: String, criterion_combination: CriterionCombination, audience: Audience) -> SharedSpace
    change_audience: (owner: core/Participant, space: SharedSpace, audience: Audience) -> SharedSpace
    change_criterion_combination: (owner: core/Participant, space: SharedSpace, criterion_combination: CriterionCombination) -> SharedSpace
    add_criterion: (owner: core/Participant, space: SharedSpace, selector: PageSelector) -> SharedSpaceCriterion
    remove_criterion: (owner: core/Participant, criterion: SharedSpaceCriterion) -> SharedSpaceCriterion
    include_page: (owner: core/Participant, space: SharedSpace, page: core/Page) -> ManualPageInclusion
    remove_included_page: (owner: core/Participant, inclusion: ManualPageInclusion) -> ManualPageInclusion
    invite: (owner: core/Participant, space: SharedSpace, permissions: Set<Permission>, lifetime: Duration) -> AccessInvitation
    redeem: (invitation: AccessInvitation, person_name: String) -> AccessGrant
    grant: (owner: core/Participant, space: SharedSpace, participant: core/Participant, permissions: Set<Permission>) -> AccessGrant
    change_permissions: (owner: core/Participant, grant: AccessGrant, permissions: Set<Permission>) -> AccessGrant
    revoke: (owner: core/Participant, grant: AccessGrant) -> AccessGrant
    read: (reader: core/Participant, space: SharedSpace, page: core/Page) -> core/Page
    contribute: (author: core/Participant, space: SharedSpace, page: core/Page, change: core/Change) -> SharedProposal
    edit: (author: core/Participant, space: SharedSpace, page: core/Page, change: core/Change) -> core/Submission
    create_page: (author: core/Participant, space: SharedSpace, change: core/Change) -> core/Page

    @invariant SharingIsDelimited
        -- A shared space names zero or more criteria and zero or more explicit
        -- pages. Its effective membership is computed only from those declared
        -- sources. Admission never reveals, searches or grants authority over
        -- the rest of the personal graph.

    @invariant TheGraphHasOneOwnerAndMayHaveManyAuthors
        -- Sharing does not make the graph collectively owned. An authorized
        -- participant may contribute or edit, and every resulting revision keeps
        -- that participant's authorship instead of being attributed to the owner.

    @invariant AccessAndAuthorityAreDifferent
        -- Being able to read a space does not imply contribution or editing.
        -- Every operation is checked against the active grant and the page on
        -- which it acts.

    @invariant PeopleWithoutVeraCanParticipateFully
        -- A person may accept an invitation in an ordinary browser and enter the
        -- shared space immediately. Registering a passkey afterwards preserves
        -- access beyond that browser session but is never a condition for the
        -- first entry or for receiving the invitation's permissions.

    @invariant ContributionAndEditingAreDifferentPromises
        -- `contribute` submits an attributed proposal for the owner's review.
        -- `edit` applies an attributed change directly to the canonical page.
        -- Neither one silently behaves as the other.

    @invariant RevocationStopsTheFutureNotThePast
        -- Revoking a grant ends subsequent access and mutation. It preserves the
        -- participant, their revisions and every decision already recorded.

    @invariant MembershipAndAccessAreIndependent
        -- Criteria and explicit inclusions decide which pages are in the space.
        -- Audience and grants decide who may read or act there. Changing either
        -- dimension never silently changes the other.

    @invariant OnePageMayBelongToSeveralSpaces
        -- A page has one canonical identity and revision history even when it is
        -- selected or explicitly included by several spaces. Membership creates
        -- contextual addresses, never duplicate pages.

    @invariant MembershipHasVisibleProvenance
        -- For every effective page the owner can tell whether it is present by
        -- one or more criteria, by explicit inclusion, or by both. A dynamic
        -- criterion match is never rewritten as hidden front matter.

    @invariant ALinkDoesNotPublishItsTarget
        -- Linking to an existing page never adds that page to the space. A link
        -- to something outside the boundary is visible as an unavailable target
        -- and reveals nothing about whether that target exists in the graph.
}

contract ScopedPageAddressing {
    personal_address: (page: core/Page) -> String
    shared_address: (space: SharedSpace, page: core/Page) -> String
    public_address: (page: core/Page) -> String

    @invariant EachSurfaceHasItsOwnNamespace
        -- The public site occupies the origin root, the owner's personal graph
        -- occupies `/p`, and shared spaces occupy `/s/<space>`. Authority is
        -- therefore explicit in the address instead of varying invisibly with
        -- the reader of one URL.

    @invariant OnePageIdentityMayHaveSeveralContextualAddresses
        -- Personal, shared and public addresses may resolve to the same stable
        -- page identity and revision history. Addressing never duplicates the
        -- page or forks its authorship.

    @invariant ASharedAddressCarriesItsBoundary
        -- A route beneath `/s/<space>` resolves search, links, backlinks and
        -- mutations within that named space before page content is returned.

    @guidance
        -- Public pages use `/<published-path>`, personal pages use
        -- `/p/<page-path>`, and shared pages use
        -- `/s/<space-slug>/<page-path>`.
}

contract InvitationCapability {
    deliver: (invitation: AccessInvitation, channel: DeliveryChannel) -> AccessInvitation
    redeem: (invitation: AccessInvitation, proof: String) -> AccessInvitation
    revoke: (owner: core/Participant, invitation: AccessInvitation) -> AccessInvitation
    delete: (owner: core/Participant, invitation: AccessInvitation) -> AccessInvitation

    @invariant DeliveryDoesNotBecomeIdentity
        -- Email, a message, a copied link and a QR code are ways to transport an
        -- invitation. None becomes the participant's permanent identity.

    @invariant TheInvitationCarriesItsBoundary
        -- Before delivery, an invitation already fixes its shared space and
        -- permissions. Whoever receives it cannot enlarge either while claiming.

    @invariant AcceptingAnInvitationFindsTheSpace
        -- Successful redemption enters the participant into the invited space.
        -- They never have to infer or discover a page address after proving the
        -- capability, irrespective of how shared-space addresses are ultimately
        -- represented.

    @invariant ACapabilityIsSingleUseAndExpiring
        -- A successful redemption consumes the invitation and creates one
        -- bounded session for its participant. An expired, revoked or already
        -- redeemed invitation creates no session, identity or grant.

    @invariant TheSecretIsNotRecoverableFromVera
        -- Vera retains what is needed to verify an invitation secret, never the
        -- bearer secret itself after it has been shown or delivered.
}

contract FederatedHumanIdentity {
    bind: (participant: core/Participant, remote_identity: String, invitation: AccessInvitation) -> FederatedIdentityBinding
    authenticate: (binding: FederatedIdentityBinding, assertion: String) -> HumanSession
    unbind: (participant: core/Participant, binding: FederatedIdentityBinding) -> FederatedIdentityBinding

    @invariant FederationIsOptional
        -- A Vera identity improves continuity between personal graphs but never
        -- replaces browser participation for people without Vera.

    @invariant LinkingProvesBothSides
        -- A local guest identity and a remote Vera identity are joined only
        -- after control of both has been demonstrated. Equal names or email
        -- addresses never merge people automatically.

    @invariant PermanentMeansBoundNotLoggedInForever
        -- The binding remains until revoked; every assertion and session remains
        -- short-lived. Federation creates durable recognition, not an immortal
        -- login token.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum Audience { anybody | restricted }
enum Permission { read | contribute | edit }
enum CriterionCombination { match_any | match_all }
enum CriterionStatus { active | removed }
enum InclusionStatus { active | removed }
enum AuthenticatorKind { passkey }
enum AuthenticatorStatus { active | revoked }
enum SessionStatus { active | ended | expired }
enum SessionAuthenticationMethod { invitation | passkey | federated_vera }
enum BootstrapStatus { awaiting_first_passkey | ready }
enum SpaceStatus { active | withdrawn }
enum InvitationStatus { pending | redeemed | revoked | expired }
enum GrantStatus { active | revoked }
enum DeliveryChannel { email | secret_link | qr_code | split_code | owner_confirmation }
enum ProposalStatus { awaiting_review | accepted | rejected }
enum BindingStatus { active | revoked }
enum EnrollmentStatus { pending | completed | revoked | expired }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity HumanAuthenticator {
    instance: identity/VeraInstance
    participant: core/Participant
    kind: AuthenticatorKind
    label: String
    status: AuthenticatorStatus
    registered_at: Timestamp
    revoked_at: Timestamp?

    transitions status {
        active -> revoked
        terminal: revoked
    }
}

entity HumanSession {
    instance: identity/VeraInstance
    participant: core/Participant
    authenticator: HumanAuthenticator?
    federated_binding: FederatedIdentityBinding?
    invitation: AccessInvitation?
    authentication_method: SessionAuthenticationMethod
    status: SessionStatus
    began_at: Timestamp
    expires_at: Timestamp
    ended_at: Timestamp?
    owner_authenticators: HumanAuthenticator with instance = this.instance and participant = this.participant
    active_owner_authenticators: HumanAuthenticator with instance = this.instance and participant = this.participant and status = active
    owner_sessions: HumanSession with instance = this.instance and participant = this.participant
    public_sites: core/PersonalSite with graph = this.instance.graph and owner = this.participant
    shared_spaces: SharedSpace with graph = this.instance.graph
    shared_access: AccessGrant with space.graph = this.instance.graph
    pending_invitations: AccessInvitation with space.graph = this.instance.graph and status = pending

    transitions status {
        active -> ended
        active -> expired
        terminal: ended, expired
    }
}

-- A fresh installation already knows which local graph it serves and who owns
-- it, but it is not remotely usable until that owner registers the first
-- passkey from the machine holding the corpus.
entity HumanAccessBootstrap {
    instance: identity/VeraInstance
    status: BootstrapStatus

    transitions status {
        awaiting_first_passkey -> ready
        terminal: ready
    }
}

-- An enrollment is authorization to add an authenticator. For the owner it can
-- be born only from the machine; for an invited participant it is born from a
-- redeemed invitation.
entity AuthenticatorEnrollment {
    instance: identity/VeraInstance
    participant: core/Participant
    authorized_by: core/Participant
    status: EnrollmentStatus
    expires_at: Timestamp

    transitions status {
        pending -> completed
        pending -> revoked
        pending -> expired
        terminal: completed, revoked, expired
    }
}

entity SharedSpace {
    graph: core/Graph
    owner: core/Participant
    name: String
    slug: String
    criterion_combination: CriterionCombination
    audience: Audience
    status: SpaceStatus
    created_at: Timestamp
    grants: AccessGrant with space = this
    invitations: AccessInvitation with space = this
    proposals: SharedProposal with space = this
    criteria: SharedSpaceCriterion with space = this and status = active
    manual_inclusions: ManualPageInclusion with space = this and status = active
    pages: effective_shared_pages(graph.pages, criteria, criterion_combination, manual_inclusions)

    transitions status {
        active -> withdrawn
        terminal: withdrawn
    }
}

entity SharedSpaceCriterion {
    space: SharedSpace
    selector: PageSelector
    status: CriterionStatus
    added_by: core/Participant
    added_at: Timestamp
    removed_at: Timestamp?

    transitions status {
        active -> removed
        terminal: removed
    }
}

entity ManualPageInclusion {
    space: SharedSpace
    page: core/Page
    status: InclusionStatus
    added_by: core/Participant
    added_at: Timestamp
    removed_at: Timestamp?

    transitions status {
        active -> removed
        terminal: removed
    }
}

entity AccessInvitation {
    space: SharedSpace
    issued_by: core/Participant
    permissions: Set<Permission>
    proof_digest: String
    intended_contact: String?
    status: InvitationStatus
    issued_at: Timestamp
    expires_at: Timestamp
    redeemed_by: core/Participant?
    redeemed_at: Timestamp?

    transitions status {
        pending -> redeemed
        pending -> revoked
        pending -> expired
        terminal: redeemed, revoked, expired
    }
}

entity AccessGrant {
    space: SharedSpace
    participant: core/Participant
    permissions: Set<Permission>
    status: GrantStatus
    granted_by: core/Participant
    granted_at: Timestamp
    revoked_at: Timestamp?

    transitions status {
        active -> revoked
        terminal: revoked
    }
}

entity SharedProposal {
    space: SharedSpace
    page: core/Page
    author: core/Participant
    change: core/Change
    status: ProposalStatus
    proposed_at: Timestamp
    reviewed_by: core/Participant?
    reviewed_at: Timestamp?

    transitions status {
        awaiting_review -> accepted
        awaiting_review -> rejected
        terminal: accepted, rejected
    }
}

entity FederatedIdentityBinding {
    instance: identity/VeraInstance
    participant: core/Participant
    remote_identity: String
    status: BindingStatus
    bound_at: Timestamp
    revoked_at: Timestamp?

    transitions status {
        active -> revoked
        terminal: revoked
    }
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    default_invitation_lifetime: Duration = 7.days
    maximum_invitation_lifetime: Duration = 30.days
    session_lifetime: Duration = 30.days
    enrollment_lifetime: Duration = 15.minutes
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule OwnerAuthorizesOwnAuthenticatorFromMachine {
    when: AuthorizeOwnerAuthenticatorFromMachine(owner)

    requires: identity/is_local_to_the_instance
    requires: instance.owner = owner

    ensures: AuthenticatorEnrollment.created(
        instance: instance,
        participant: owner,
        authorized_by: owner,
        status: pending,
        expires_at: now + config.enrollment_lifetime
    )
}

rule FreshInstanceBeginsOwnerAuthenticationBootstrap {
    when: fresh_instance: identity/VeraInstance.created

    ensures:
        HumanAccessBootstrap.created(
            instance: fresh_instance,
            status: awaiting_first_passkey
        )
        AuthenticatorEnrollment.created(
            instance: fresh_instance,
            participant: fresh_instance.owner,
            authorized_by: fresh_instance.owner,
            status: pending,
            expires_at: now + config.enrollment_lifetime
        )
}

rule ParticipantRegistersPasskey {
    when: RegisterPasskey(participant, enrollment, label)

    requires: enrollment.instance = instance
    requires: enrollment.participant = participant
    requires: enrollment.status = pending
    requires: enrollment.expires_at > now

    ensures:
        HumanAuthenticator.created(
            instance: instance,
            participant: participant,
            kind: passkey,
            label: label,
            status: active,
            registered_at: now,
            revoked_at: null
        )
        enrollment.status = completed
}

rule FirstOwnerPasskeyCompletesBootstrap {
    when: authenticator: HumanAuthenticator.created

    let bootstrap = HumanAccessBootstrap{instance: authenticator.instance}

    requires: exists bootstrap
    requires: bootstrap.status = awaiting_first_passkey
    requires: authenticator.participant = authenticator.instance.owner

    ensures: bootstrap.status = ready
}

rule HumanAuthenticatesWithPasskey {
    when: AuthenticateWithPasskey(authenticator)

    requires: authenticator.instance = instance
    requires: authenticator.kind = passkey
    requires: authenticator.status = active

    ensures: HumanSession.created(
        instance: instance,
        participant: authenticator.participant,
        authenticator: authenticator,
        federated_binding: null,
        invitation: null,
        authentication_method: passkey,
        status: active,
        began_at: now,
        expires_at: now + config.session_lifetime,
        ended_at: null
    )
}

rule OwnerRevokesOwnPasskey {
    when: RevokeHumanAuthenticator(owner, authenticator)

    requires: owner = authenticator.instance.owner
    requires: authenticator.participant = owner
    requires: authenticator.status = active

    ensures:
        authenticator.status = revoked
        authenticator.revoked_at = now
        for session in HumanSessions:
            session.authenticator = authenticator and session.status = active implies
                session.status = ended
                session.ended_at = now
}

rule HumanEndsSession {
    when: EndHumanSession(participant, session)

    requires: session.participant = participant
    requires: session.status = active

    ensures:
        session.status = ended
        session.ended_at = now
}

rule HumanSessionExpires {
    when: session: HumanSession.expires_at <= now

    requires: session.status = active

    ensures:
        session.status = expired
        session.ended_at = now
}

rule OwnerCreatesSharedSpace {
    when: CreateSharedSpace(owner, name, slug, criterion_combination, audience)

    requires: instance.owner = owner

    ensures: SharedSpace.created(
        graph: instance.graph,
        owner: owner,
        name: name,
        slug: slug,
        criterion_combination: criterion_combination,
        audience: audience,
        status: active,
        created_at: now
    )
}

rule OwnerChangesSharedSpaceAudience {
    when: ChangeSharedSpaceAudience(owner, space, audience)

    requires: space.owner = owner
    requires: space.status = active

    ensures: space.audience = audience
}

rule OwnerChangesCriterionCombination {
    when: ChangeCriterionCombination(owner, space, criterion_combination)

    requires: space.owner = owner
    requires: space.status = active

    ensures: space.criterion_combination = criterion_combination
}

rule OwnerAddsSharedSpaceCriterion {
    when: AddSharedSpaceCriterion(owner, space, selector)

    requires: space.owner = owner
    requires: space.status = active
    requires: not exists SharedSpaceCriterion{space: space, selector: selector, status: active}

    ensures: SharedSpaceCriterion.created(
        space: space,
        selector: selector,
        status: active,
        added_by: owner,
        added_at: now,
        removed_at: null
    )
}

rule OwnerRemovesSharedSpaceCriterion {
    when: RemoveSharedSpaceCriterion(owner, criterion)

    requires: criterion.space.owner = owner
    requires: criterion.status = active

    ensures:
        criterion.status = removed
        criterion.removed_at = now
}

rule OwnerExplicitlyIncludesPage {
    when: IncludePageInSharedSpace(owner, space, page)

    requires: space.owner = owner
    requires: space.status = active
    requires: page.graph = space.graph
    requires: not exists ManualPageInclusion{space: space, page: page, status: active}

    ensures: ManualPageInclusion.created(
        space: space,
        page: page,
        status: active,
        added_by: owner,
        added_at: now,
        removed_at: null
    )
}

rule OwnerRemovesExplicitPageInclusion {
    when: RemovePageFromSharedSpace(owner, inclusion)

    requires: inclusion.space.owner = owner
    requires: inclusion.status = active

    ensures:
        inclusion.status = removed
        inclusion.removed_at = now
}

rule OwnerCreatesInvitationCapability {
    when: InviteToSharedSpace(owner, space, permissions, lifetime, proof_digest, intended_contact?)

    requires: space.owner = owner
    requires: space.status = active
    requires: permissions.count > 0
    requires: read in permissions
    requires: lifetime > 0.seconds
    requires: lifetime <= config.maximum_invitation_lifetime

    ensures: AccessInvitation.created(
        space: space,
        issued_by: owner,
        permissions: permissions,
        proof_digest: proof_digest,
        intended_contact: intended_contact,
        status: pending,
        issued_at: now,
        expires_at: now + lifetime,
        redeemed_by: null,
        redeemed_at: null
    )
}

rule PendingInvitationExpires {
    when: invitation: AccessInvitation.expires_at <= now

    requires: invitation.status = pending

    ensures: invitation.status = expired
}

rule OwnerRevokesPendingInvitation {
    when: RevokeInvitation(owner, invitation)

    requires: invitation.space.owner = owner
    requires: invitation.status = pending

    ensures: invitation.status = revoked
}

rule OwnerDeletesInvitation {
    when: DeleteInvitation(owner, invitation)

    requires: invitation.space.owner = owner

    ensures:
        if invitation.status = redeemed:
            invitation.redeemed_by.grants.remove(grant => grant.space = invitation.space)
        not exists invitation

    @guidance
        -- Removing a redeemed invitation also revokes the access born from it.
        -- The participant and access to any other shared spaces remain.
}

rule PersonWithoutVeraRedeemsInvitation {
    when: RedeemInvitation(invitation, proof, person_name)

    requires: invitation.status = pending
    requires: invitation.expires_at > now
    requires: verifies(proof, invitation.proof_digest)

    ensures:
        let participant = core/Participant.created(
            name: person_name,
            kind: human,
            status: active
        )
        core/Membership.created(
            graph: invitation.space.graph,
            participant: participant,
            status: active
        )
        AccessGrant.created(
            space: invitation.space,
            participant: participant,
            permissions: invitation.permissions,
            status: active,
            granted_by: invitation.space.owner,
            granted_at: now,
            revoked_at: null
        )
        AuthenticatorEnrollment.created(
            instance: instance,
            participant: participant,
            authorized_by: invitation.space.owner,
            status: pending,
            expires_at: now + config.enrollment_lifetime
        )
        HumanSession.created(
            instance: instance,
            participant: participant,
            authenticator: null,
            federated_binding: null,
            invitation: invitation,
            authentication_method: invitation,
            status: active,
            began_at: now,
            expires_at: now + config.session_lifetime,
            ended_at: null
        )
        invitation.status = redeemed
        invitation.redeemed_by = participant
        invitation.redeemed_at = now
}

rule OwnerGrantsKnownParticipantAccess {
    when: GrantSharedSpaceAccess(owner, space, participant, permissions)

    requires: space.owner = owner
    requires: space.status = active
    requires: permissions.count > 0
    requires: read in permissions
    requires: exists core/Membership{graph: space.graph, participant: participant, status: active}
    requires: not exists AccessGrant{space: space, participant: participant, status: active}

    ensures: AccessGrant.created(
        space: space,
        participant: participant,
        permissions: permissions,
        status: active,
        granted_by: owner,
        granted_at: now,
        revoked_at: null
    )
}

rule OwnerRevokesSharedSpaceAccess {
    when: RevokeSharedSpaceAccess(owner, grant)

    requires: grant.space.owner = owner
    requires: grant.status = active

    ensures:
        grant.status = revoked
        grant.revoked_at = now
}

rule OwnerChangesSharedSpacePermissions {
    when: ChangeSharedSpacePermissions(owner, grant, permissions)

    requires: grant.space.owner = owner
    requires: grant.status = active
    requires: permissions.count > 0
    requires: read in permissions

    ensures: grant.permissions = permissions
}

rule AuthorizedParticipantContributes {
    when: ProposeSharedChange(participant, space, page, change)

    let grant = AccessGrant{space: space, participant: participant, status: active}

    requires: exists grant
    requires: contribute in grant.permissions
    requires: page in space.pages
    requires: subject_page(change) = page

    ensures: SharedProposal.created(
        space: space,
        page: page,
        author: participant,
        change: change,
        status: awaiting_review,
        proposed_at: now,
        reviewed_by: null,
        reviewed_at: null
    )
}

rule AuthorizedParticipantEditsCanonicalPage {
    when: EditSharedPage(participant, space, page, origin_id, change, channel, evidence?)

    let grant = AccessGrant{space: space, participant: participant, status: active}

    requires: participant = space.owner or (exists grant and edit in grant.permissions)
    requires: page in space.pages
    requires: subject_page(change) = page
    requires: channel != authenticated_voice or evidence != null

    ensures: core/ParticipantSubmits(participant, space.graph, origin_id, change, channel, evidence)
}

rule AuthorizedParticipantCreatesPageInsideSharedSpace {
    when: CreatePageInSharedSpace(participant, space, page_origin_id, page_change, channel, evidence?)

    let grant = AccessGrant{space: space, participant: participant, status: active}

    requires: participant = space.owner or (exists grant and edit in grant.permissions)
    requires: creates_page(page_change)
    requires: channel != authenticated_voice or evidence != null

    ensures: core/ParticipantSubmits(participant, space.graph, page_origin_id, page_change, channel, evidence)

    @guidance
        -- Creating a canonical page does not silently publish it. The owner may
        -- include it explicitly, or it may enter later by satisfying the space's
        -- declared criteria.
}

rule OwnerAcceptsSharedProposal {
    when: ReviewSharedProposal(owner, proposal, accept)

    requires: proposal.space.owner = owner
    requires: proposal.status = awaiting_review

    ensures:
        applied_atomically(proposal.change, attributed_to: proposal.author)
        proposal.status = accepted
        proposal.reviewed_by = owner
        proposal.reviewed_at = now
}

rule OwnerRejectsSharedProposal {
    when: ReviewSharedProposal(owner, proposal, reject)

    requires: proposal.space.owner = owner
    requires: proposal.status = awaiting_review

    ensures:
        proposal.status = rejected
        proposal.reviewed_by = owner
        proposal.reviewed_at = now
}

rule InvitedParticipantBindsRemoteVeraIdentity {
    when: BindRemoteVeraIdentity(participant, invitation, remote_identity, local_proof, remote_proof)

    requires: invitation.status = redeemed
    requires: invitation.redeemed_by = participant
    requires: verifies_local_participant(local_proof, participant)
    requires: verifies_remote_vera(remote_proof, remote_identity)
    requires: not exists FederatedIdentityBinding{instance: instance, participant: participant, remote_identity: remote_identity}

    ensures: FederatedIdentityBinding.created(
        instance: instance,
        participant: participant,
        remote_identity: remote_identity,
        status: active,
        bound_at: now,
        revoked_at: null
    )
}

rule FederatedParticipantAuthenticates {
    when: AuthenticateFederatedIdentity(binding, assertion)

    requires: binding.instance = instance
    requires: binding.status = active
    requires: verifies_remote_vera(assertion, binding.remote_identity)

    ensures: HumanSession.created(
            instance: instance,
            participant: binding.participant,
            authenticator: null,
            federated_binding: binding,
            invitation: null,
            authentication_method: federated_vera,
            status: active,
            began_at: now,
            expires_at: now + config.session_lifetime,
            ended_at: null
    )
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant EverySharedPageBelongsToItsGraph {
    for space in SharedSpaces:
        space.pages.all(page => page.graph = space.graph)
}

invariant EveryExplicitlyIncludedPageBelongsToTheSpaceGraph {
    for inclusion in ManualPageInclusions:
        inclusion.page.graph = inclusion.space.graph
}

invariant AnActiveCriterionAppearsOnlyOncePerSpace {
    for a in SharedSpaceCriteria:
        for b in SharedSpaceCriteria:
            a != b and a.space = b.space and a.status = active and b.status = active implies
                a.selector != b.selector
}

invariant AnActiveManualInclusionAppearsOnlyOncePerSpace {
    for a in ManualPageInclusions:
        for b in ManualPageInclusions:
            a != b and a.space = b.space and a.status = active and b.status = active implies
                a.page != b.page
}

invariant EverySharedSpaceBelongsToItsSovereignOwner {
    for space in SharedSpaces:
        space.graph.owner = space.owner
}

invariant EveryGrantIsDelimitedToOneSharedSpace {
    for grant in AccessGrants:
        grant.space.graph = instance.graph
}

invariant ASessionAuthenticatorNamesTheSamePerson {
    for session in HumanSessions:
        session.authenticator != null implies
            session.authenticator.participant = session.participant
}

invariant ASessionFederatedBindingNamesTheSamePerson {
    for session in HumanSessions:
        session.federated_binding != null implies
            session.federated_binding.participant = session.participant
}

invariant ASessionInvitationNamesTheSamePerson {
    for session in HumanSessions:
        session.invitation != null implies
            session.invitation.redeemed_by = session.participant
}

invariant EverySessionHasExactlyOneProof {
    for session in HumanSessions:
        (session.authenticator != null or session.federated_binding != null or session.invitation != null) and
        not (session.authenticator != null and session.federated_binding != null) and
        not (session.authenticator != null and session.invitation != null) and
        not (session.federated_binding != null and session.invitation != null)
}

invariant EveryInstanceHasOneHumanAccessBootstrap {
    for a in HumanAccessBootstraps:
        for b in HumanAccessBootstraps:
            a != b implies a.instance != b.instance
}

invariant ReadyMeansTheOwnerHasAnActivePasskey {
    for bootstrap in HumanAccessBootstraps:
        bootstrap.status = ready implies exists HumanAuthenticator{
            instance: bootstrap.instance,
            participant: bootstrap.instance.owner,
            kind: passkey,
            status: active
        }
}

invariant TheOwnerNeverNeedsASharedSpaceGrant {
    for grant in AccessGrants:
        grant.participant != grant.space.owner
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor AuthenticatedHuman {
    within: HumanSession
    identified_by: core/Participant where this = within.participant and within.status = active
}

actor AuthenticatedOwner {
    within: HumanSession
    identified_by: core/Participant
        where this = within.participant and this = within.instance.owner and within.status = active
}

actor SharedSpaceOwner {
    within: SharedSpace
    identified_by: core/Participant where this = within.owner and this.kind = human
}

actor AuthorizedSharedParticipant {
    within: SharedSpace
    identified_by: core/Participant where exists AccessGrant{space: within, participant: this, status: active}
}

actor SharedSpaceEditor {
    within: SharedSpace
    identified_by: core/Participant where
        this = within.owner or
        (exists AccessGrant{space: within, participant: this, status: active} and
         edit in AccessGrant{space: within, participant: this, status: active}.permissions)
}

actor AnybodySharedSpaceReader {
    within: SharedSpace
    identified_by: identity/PublicIdentity
        where this = anybody and within.audience = anybody and within.status = active
}

actor EnrollmentParticipant {
    within: AuthenticatorEnrollment
    identified_by: core/Participant where this = within.participant and within.status = pending
}

actor PasskeyHolder {
    within: HumanAuthenticator
    identified_by: core/Participant where this = within.participant and within.status = active
}

actor InvitationBearer {
    identified_by: AccessInvitation where this.status = pending
}

actor FederatedParticipant {
    within: FederatedIdentityBinding
    identified_by: core/Participant where this = within.participant and within.status = active
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface LocalOwnerAuthenticatorRecovery {
    facing owner: identity/SovereignOwner
    context instance: identity/VeraInstance

    provides:
        AuthorizeOwnerAuthenticatorFromMachine(owner) when owner = instance.owner

    contracts:
        fulfils HumanAccess

    @guarantee NoNetworkEquivalentExists
        -- This surface is available only from the machine holding the corpus.
        -- No HTTP request, reverse proxy or private network route can invoke it.
}

surface AuthenticatorEnrollmentBoundary {
    facing participant: EnrollmentParticipant
    context enrollment: AuthenticatorEnrollment where participant = enrollment.participant and status = pending

    exposes:
        enrollment.expires_at

    provides:
        RegisterPasskey(participant, enrollment, label)

    contracts:
        fulfils HumanAccess

    @guarantee EnrollmentCreatesNoAdditionalAuthority
        -- Registering an authenticator proves the participant in later visits;
        -- it does not enlarge that participant's grants or graph membership.
}

surface FirstRunOwnerSetup {
    facing owner: EnrollmentParticipant
    context enrollment: AuthenticatorEnrollment
        where owner = enrollment.participant
        and enrollment.participant = enrollment.instance.owner
        and enrollment.status = pending
        and exists HumanAccessBootstrap{instance: enrollment.instance, status: awaiting_first_passkey}

    exposes:
        enrollment.instance.graph.name
        enrollment.instance.owner.name
        enrollment.expires_at

    provides:
        RegisterPasskey(owner, enrollment, label)

    contracts:
        fulfils HumanAccess

    @guarantee EveryInstallationEstablishesItsOwnOwner
        -- First run names the owner and graph belonging to this local corpus.
        -- It imports neither Herbert's identity nor any authenticator, session
        -- or recovery secret from the installation that built Vera.

    @guarantee RemoteUseBeginsOnlyAfterTheFirstPasskey
        -- Until this local ceremony succeeds, the instance has no authenticated
        -- owner session and cannot be administered from a network browser.
}

surface PasskeyLoginBoundary {
    facing participant: PasskeyHolder
    context authenticator: HumanAuthenticator where participant = authenticator.participant and status = active

    provides:
        AuthenticateWithPasskey(authenticator)

    contracts:
        fulfils HumanAccess

    @guarantee AuthenticationDoesNotChooseAuthorization
        -- Login proves the participant. The active grant on each shared space,
        -- not the authenticator, decides what that participant may do there.
}

surface SharedSpaceCreation {
    facing owner: identity/SovereignOwner
    context instance: identity/VeraInstance

    provides:
        CreateSharedSpace(owner, name, slug, criterion_combination, audience)
            when owner = instance.owner

    contracts:
        fulfils SharedSpaceAccess
        fulfils ScopedPageAddressing

    @guarantee CreatingASpaceDoesNotPublishTheRest
        -- A selector for one space exposes no non-matching page of the graph.
}

surface InvitationRedemption {
    facing invitation: InvitationBearer
    context space: SharedSpace where invitations.any(one => one = invitation)

    exposes:
        space.name
        invitation.permissions
        invitation.expires_at

    provides:
        RedeemInvitation(invitation, proof, person_name)

    contracts:
        fulfils InvitationCapability

    @guarantee RedemptionRevealsOnlyWhatIsNeededToConsent
        -- Before redemption, the bearer sees the space name, offered permissions
        -- and expiry, not its pages or any fact about the surrounding graph.

    @guarantee RedemptionContinuesIntoTheInvitedSpace
        -- Successful redemption opens a bounded session and takes the person to
        -- the invited space without first requiring an operating-system
        -- authentication ceremony. If the invitation was reached while
        -- requesting one of its pages, that page is the continuation; otherwise
        -- its space home is.

    @guarantee APasskeyIsProgressiveAndExplained
        -- Once inside, Vera offers to preserve access with a passkey but allows
        -- the person to defer it. Before invoking the operating-system dialog,
        -- Vera explains that the device may ask for face, fingerprint or PIN,
        -- may name its credential manager, and shares none of those secrets
        -- with Vera. Deferring means a lost or expired session requires another
        -- invitation.
}

surface HumanSessionBoundary {
    facing participant: AuthenticatedHuman
    context session: HumanSession where participant = session.participant and status = active

    exposes:
        session.participant
        session.authentication_method
        session.authenticator
        session.federated_binding
        session.invitation
        session.expires_at

    provides:
        EndHumanSession(participant, session)

    contracts:
        fulfils HumanAccess

    @guarantee SessionAuthorityComesFromItsParticipant
        -- Every request within this boundary acts as the participant named by
        -- the verified session, never as a participant claimed by request data.
}

surface OwnerAdministrationOverview {
    facing owner: AuthenticatedOwner
    context session: HumanSession where owner = session.participant and status = active

    exposes:
        session.participant
        session.authentication_method
        session.authenticator
        session.federated_binding
        session.expires_at
        session.public_sites
        session.shared_spaces
        session.pending_invitations

    contracts:
        fulfils OwnerAdministration

    @guarantee CurrentAuthenticationIsAlwaysVisible
        -- The administration header states who is authenticated, whether this
        -- session came from a passkey or a federated Vera, and when it expires.

    @guarantee OverviewLeadsWithSpaces
        -- Shared spaces are the primary collection. Pending invitations are a
        -- separate queue and never masquerade as participant accounts.
}

surface OwnerAccessAdministration {
    facing owner: AuthenticatedOwner
    context session: HumanSession where owner = session.participant and status = active

    exposes:
        session.participant
        session.authentication_method
        session.authenticator
        session.federated_binding
        session.expires_at
        session.owner_authenticators
        session.owner_sessions

    provides:
        EndHumanSession(owner, other_session)
            when other_session in session.owner_sessions and other_session.status = active
        RevokeHumanAuthenticator(owner, authenticator)
            when authenticator in session.owner_authenticators
            and authenticator.status = active
            and session.active_owner_authenticators.count > 1

    contracts:
        fulfils HumanAccess
        fulfils OwnerAdministration

    @guarantee RecoveryIsDescribedButNotPerformedHere
        -- This network view explains that the corpus machine is the final
        -- recovery authority, but cannot invoke that local-only capability.

    @guarantee RevocationEndsDependentSessions
        -- Revoking a passkey closes every active session created through it;
        -- historical authorship remains attributed to the owner.

    @guarantee TheLastOwnerPasskeyIsNotRevokedRemotely
        -- The network administration view requires another active owner
        -- passkey. Replacing the last one belongs to local machine recovery.
}

surface OwnerSharedSpaceDirectory {
    facing owner: AuthenticatedOwner
    context session: HumanSession where owner = session.participant and status = active

    exposes:
        session.public_sites
        session.shared_spaces
        session.pending_invitations

    provides:
        CreateSharedSpace(owner, name, slug, criterion_combination, audience)

    contracts:
        fulfils SharedSpaceAccess
        fulfils OwnerAdministration
        fulfils ScopedPageAddressing

    @guarantee SpaceDirectoryIsTheSharingHome
        -- Every way this graph leaves the owner's private workspace appears in
        -- one directory. The public site is the root, freely readable sharing
        -- space; authenticated spaces follow it. Audience, page count,
        -- participant count and pending invitation count are summaries under
        -- each whole-card disclosure control, whose icon, status and metrics
        -- make its interactive boundary apparent before opening it. Editing
        -- remains local to the opened space. The same directory is reached from
        -- Settings → Sharing and `VERA:Publicación`; neither entry maintains a
        -- reduced or independent administration.

    @guarantee SharedSpaceCreationUsesTheDirectoryPattern
        -- A button named "Agregar espacio compartido" opens an inline creation
        -- area with the same name, address, criterion-combination and audience
        -- structure used inside existing spaces. A space may begin empty;
        -- closing the area does not create or alter one.

    @guarantee PublicationRemainsExplicitInsideUnifiedSharing
        -- Presenting the public site beside authenticated spaces does not turn
        -- its publications into selector membership. Its explicit publication
        -- rows, paths, canonical origin and entry point remain the authority.
}

surface OwnerPeopleDirectory {
    facing owner: AuthenticatedOwner
    context session: HumanSession where owner = session.participant and status = active

    exposes:
        session.shared_access

    contracts:
        fulfils OwnerAdministration

    @guarantee PeopleRemainASecondaryCrossSpaceView
        -- A stable participant is shown with their grants grouped by space and
        -- authentication bindings. Changing one grant cannot affect another.

    @guarantee PendingInvitationsAreExcluded
        -- The people directory contains accepted identities and their access,
        -- never unredeemed invitation secrets.
}

surface SharedSpaceAdministration {
    facing owner: SharedSpaceOwner
    context space: SharedSpace

    exposes:
        space.name
        space.criterion_combination
        space.criteria
        space.manual_inclusions
        space.pages
        space.audience
        space.grants
        space.invitations

    provides:
        ChangeSharedSpaceAudience(owner, space, audience)
        ChangeCriterionCombination(owner, space, criterion_combination)
        AddSharedSpaceCriterion(owner, space, selector)
        RemoveSharedSpaceCriterion(owner, criterion) when criterion.space = space
        IncludePageInSharedSpace(owner, space, page) when page.graph = space.graph
        RemovePageFromSharedSpace(owner, inclusion) when inclusion.space = space
        InviteToSharedSpace(owner, space, permissions, lifetime, proof_digest, intended_contact?)
        GrantSharedSpaceAccess(owner, space, participant, permissions)
        ChangeSharedSpacePermissions(owner, grant, permissions) when grant.space = space
        RevokeSharedSpaceAccess(owner, grant) when grant.space = space
        RevokeInvitation(owner, invitation) when invitation.space = space
        DeleteInvitation(owner, invitation) when invitation.space = space
        ReviewSharedProposal(owner, proposal, accept)
            when proposal.space = space and proposal.status = awaiting_review
        ReviewSharedProposal(owner, proposal, reject)
            when proposal.space = space and proposal.status = awaiting_review

    contracts:
        fulfils SharedSpaceAccess
        fulfils ScopedPageAddressing
        fulfils InvitationCapability

    @guarantee InvitationsCannotDelegateAdministration
        -- An invitation may grant reading, contribution or editing, never the
        -- owner's authority to change the space, its audience or other grants.

    @guarantee AccessIsThePrimaryConfiguration
        -- The opened space leads with audience and authenticated participants.
        -- Each active participant shows their current permissions beside actions
        -- to change those permissions or remove their access. Pending invitations
        -- remain a separate, revocable list rather than appearing as users.

    @guarantee MembershipIsInspectableAndEditable
        -- The same view also shows every active criterion, how criteria combine,
        -- every explicitly included page and the effective page set. Each page
        -- states the criterion or manual inclusion that admits it, so the owner
        -- can predict the effect of changing membership without confusing that
        -- operation with access control.

    @guarantee PendingInvitationsRemainRevocable
        -- The owner chooses a bounded lifetime when issuing the invitation and
        -- may revoke it immediately from this administration until redemption
        -- or expiry. Seven days is offered by default; no invitation exceeds
        -- thirty days.

    @guarantee EveryInvitationCanBeDeleted
        -- The owner may permanently remove pending, expired, revoked or redeemed
        -- invitations. Deleting a redeemed invitation also revokes the access it
        -- granted, without removing the participant or unrelated grants.

    @guarantee InvitationsAreIssuedPerPerson
        -- Each invitation is a one-use capability intended for one person. The
        -- administration says so before issuance and lets the owner issue any
        -- number of separate links without leaving the space or losing the
        -- still-visible secrets just created.
}

surface SharedSpaceParticipation {
    facing participant: SharedSpaceEditor
    context space: SharedSpace

    exposes:
        space.name
        space.pages

    provides:
        ProposeSharedChange(participant, space, page, change)
            when contribute in AccessGrant{space: space, participant: participant, status: active}.permissions
        EditSharedPage(participant, space, page, origin_id, change, channel, evidence?)
            when participant = space.owner or
                 edit in AccessGrant{space: space, participant: participant, status: active}.permissions
        CreatePageInSharedSpace(participant, space, page_origin_id, page_change, channel, evidence?)
            when participant = space.owner or
                 edit in AccessGrant{space: space, participant: participant, status: active}.permissions

    contracts:
        fulfils SharedSpaceAccess

    @guarantee NothingOutsideTheSpaceIsDiscoverable
        -- Search, links, backlinks and navigation reached through this surface
        -- are bounded to the shared pages and reveal no title, count or absence
        -- from the rest of the graph.
}

surface PageSharedSpaceConfiguration {
    facing owner: AuthenticatedOwner
    context page: core/Page where page.graph = owner.within.instance.graph

    exposes:
        page
        containing_spaces(page)
        membership_provenance(page)

    provides:
        IncludePageInSharedSpace(owner, space, page)
            when space.owner = owner and space.graph = page.graph
        RemovePageFromSharedSpace(owner, inclusion)
            when inclusion.page = page and inclusion.space.owner = owner

    contracts:
        fulfils SharedSpaceAccess

    @guarantee OnePageMayBePublishedInSeveralSpaces
        -- Page configuration presents a multi-valued "Espacios compartidos"
        -- control. It lists every effective space and distinguishes criterion
        -- membership from explicit inclusion. Adding or removing one explicit
        -- membership leaves every other space unchanged.

    @guarantee FrontMatterDoesNotDuplicateDerivedMembership
        -- The front-matter surface may display space membership, but criterion
        -- matches remain derived from canonical page properties. Only explicit
        -- inclusions are edited as space relationships; Vera never writes a
        -- second hidden membership property that can drift from the criteria.
}

surface PublicSharedSpaceReading {
    facing reader: AnybodySharedSpaceReader
    context space: SharedSpace

    exposes:
        space.name
        space.pages

    contracts:
        fulfils ScopedPageAddressing

    @guarantee PublicAccessIsReadOnly
        -- The public projection exposes no contribution, edit, invitation or
        -- administration operation. Anybody can read only this named subgraph.

    @guarantee NothingOutsideTheSpaceIsDiscoverable
        -- Public navigation and search reveal no title, count, backlink or
        -- absence from pages outside this shared space.
}

surface FederatedIdentityLinking {
    facing participant: AuthorizedSharedParticipant
    context space: SharedSpace

    provides:
        BindRemoteVeraIdentity(participant, invitation, remote_identity, local_proof, remote_proof)
            when invitation.space = space and invitation.redeemed_by = participant

    contracts:
        fulfils FederatedHumanIdentity

    @guarantee LinkingDoesNotEnlargeTheGrant
        -- Binding a Vera identity changes how the same participant authenticates.
        -- It neither adds permissions nor grants access to another shared space.
}

surface FederatedLoginBoundary {
    facing participant: FederatedParticipant
    context binding: FederatedIdentityBinding where participant = binding.participant and status = active

    provides:
        AuthenticateFederatedIdentity(binding, assertion)

    contracts:
        fulfils FederatedHumanIdentity

    @guarantee ARemoteAssertionIsUsedOnce
        -- Each remote assertion authenticates one bounded session and cannot be
        -- replayed as a permanent bearer credential.
}

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Should a later editorial surface let the owner accept structural subsets of a contribution, or must every proposal remain indivisible?"
open question "May one person retain several independent guest identities in the same graph before explicitly linking them?"
open question "What event requires a fresh authenticator gesture rather than an existing session — destructive editing, publication, grant administration, or all three?"
open question "How does a federated Vera rotate its identity key without breaking durable bindings at remote shared spaces?"
open question "When several criteria exist, is match_any / match_all sufficient, or must owners compose nested boolean groups?"
open question "If a page matches an active criterion, should an explicit exclusion be able to keep it out of that one space without changing the page property?"
