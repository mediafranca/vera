-- allium: 3
-- content-media.allium

-- Scope: Media types that Vera stores and presents as native page content
-- Includes: Markdown, compressed audio and voice, raster images, PDF, SVG,
--   Mermaid diagrams, and JavaScript canvas sketches including p5.js
-- Excludes:
--   - Physical file layout and object storage
--   - Codec and compression implementation
--   - Canvas library selection
--   - Sandbox implementation
--   - The deliberate act that makes authored HTML or p5.js executable
--     (see executable-content-sandbox.allium)
-- Dependencies: Page and Participant are governed by core.allium

use "./core.allium" as core

------------------------------------------------------------
-- Contracts
------------------------------------------------------------

contract NativeMediaSupport {
    store: (resource: MediaResource) -> StoredMedia
    present: (resource: MediaResource) -> PresentedMedia
    rename: (resource: MediaResource, file_name: String) -> MediaResource
    replace: (resource: MediaResource, replacement_source: String, replacement_media_type: String) -> MediaResource
    delete: (resource: MediaResource) -> Boolean

    @invariant SourceFidelity
        -- Vera preserves the canonical source or original file for every resource.
        -- Presentation and transcription do not replace or destructively
        -- transcode that source. An audio source may be deleted only by an
        -- explicit participant action after its transcript has been validated.

    @invariant ManagedFileIdentity
        -- Renaming or replacing an internally managed file preserves the
        -- identity of the resource and every PageEmbedding that points to it.
        -- Deleting it is the only operation that removes those embeddings.

    @invariant NoBrokenEmbeddings
        -- Deleting an internally managed file removes all of its page
        -- embeddings in the same accepted action. A page never keeps a broken
        -- reference to a file that the catalogue says no longer exists.

    @invariant NativePresentation
        -- Every declared media variant can be presented within a Vera page
        -- without requiring the reader to export it to another application.

    @invariant DirectIngestionIsSovereign
        -- Binary media dragged, pasted, attached or sent directly by a participant
        -- is stored inside Vera. Explicit external references remain permitted.

    @invariant ExecutableContentIsolation
        -- Presenting SVG, Mermaid or JavaScript canvas content cannot grant that
        -- content access to Vera, its session or private graph data. Authored HTML
        -- and p5.js obey the same boundary under executable-content-sandbox.allium.

    @invariant MermaidRemainsSource
        -- A Mermaid block is recognised from its complete textual source. The
        -- diagram is a view onto that source: editing, copying and exporting give
        -- the source back, and a malformed diagram remains readable as source.

    @invariant P5RuntimeIsSovereign
        -- A CanvasSketch explicitly authored as p5.js uses the runtime bundled
        -- with Vera. Reading it works offline and never depends on a CDN.
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum MediaCustody { internal | external_reference }
enum TranscriptProvenance { published | automatic_original | automatic_translation }

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

entity MediaResource {
    kind: Markdown | Audio | RasterImage | Pdf | Svg | Mermaid | CanvasSketch | ExternalVideo
    graph: core/Graph
    title: String?
    file_name: String?
    source_revision: Integer
    custody: MediaCustody
    created_by: core/Participant
    created_at: Timestamp
}

variant Markdown : MediaResource {
    source: String
}

variant Audio : MediaResource {
    original_file: String?
    media_type: String
    transcript: String?
    transcript_status: none | generated | validated
    source_deleted_by: core/Participant?
    source_deleted_at: Timestamp?
    is_authenticated_voice: Boolean
}

variant RasterImage : MediaResource {
    original_file: String
    media_type: String
    alternative_text: String?
}

variant Pdf : MediaResource {
    original_file: String
}

variant Svg : MediaResource {
    source: String
    alternative_text: String?
}

variant Mermaid : MediaResource {
    source: String
}

variant CanvasSketch : MediaResource {
    javascript_source: String
    canvas_library: String?
}

variant ExternalVideo : MediaResource {
    source_url: String
    provider: String
    original_language: String?
}

entity VideoTranscript {
    video: ExternalVideo
    language: String
    original_language: String?
    provenance: TranscriptProvenance
    timestamped_text: String
    extracted_at: Timestamp
    attached_block: String
}

entity PageEmbedding {
    page: core/Page
    resource: MediaResource
    attached_by: core/Participant
    attached_at: Timestamp
}

entity StoredMedia {
    resource: MediaResource
    source_preserved: Boolean
}

entity PresentedMedia {
    resource: MediaResource
    source_preserved: Boolean
    presented_natively: Boolean
}

entity AudioArtifact {
    audio: Audio
    playback_available: Boolean
    automatic_transcription_available: Boolean
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

rule AttachMediaToPage {
    when: ParticipantAttachesMedia(participant, page, resource)

    let membership = core/Membership{graph: page.graph, participant: participant}

    requires: exists membership
    requires: membership.status = active
    requires: resource.created_by = participant

    ensures: PageEmbedding.created(
        page: page,
        resource: resource,
        attached_by: participant,
        attached_at: now
    )
}

rule IngestBinaryIntoVera {
    when: ParticipantIngestsBinary(participant, page, resource)

    let membership = core/Membership{graph: page.graph, participant: participant}

    requires: exists membership
    requires: membership.status = active
    requires: resource.created_by = participant

    ensures:
        resource.custody = internal
        PageEmbedding.created(
            page: page,
            resource: resource,
            attached_by: participant,
            attached_at: now
        )
}

rule StoreCanonicalMediaSource {
    when: StoreMedia(resource)

    ensures: StoredMedia.created(
        resource: resource,
        source_preserved: true
    )
}

rule PresentMediaWithinPage {
    when: PresentMedia(resource)

    ensures: PresentedMedia.created(
        resource: resource,
        source_preserved: true,
        presented_natively: true
    )
}

rule ParticipantRenamesManagedFile {
    when: RenameManagedFile(participant, graph, resource, file_name)

    let membership = core/Membership{graph: graph, participant: participant}

    requires: exists membership
    requires: membership.status = active
    requires: resource.graph = graph
    requires: resource.custody = internal
    requires: file_name != ""

    ensures: resource.file_name = file_name

    @guidance
        -- The resource identity and every PageEmbedding remain unchanged. A
        -- portable textual projection may rewrite its path atomically.
}

rule ParticipantReplacesManagedFile {
    when: ReplaceManagedFile(participant, graph, resource, replacement_source, replacement_media_type)

    let membership = core/Membership{graph: graph, participant: participant}

    requires: exists membership
    requires: membership.status = active
    requires: resource.graph = graph
    requires: resource.custody = internal
    requires: replacement_source != ""
    requires: replacement_media_type != ""

    ensures: resource.source_revision = resource.source_revision + 1

    @guidance
        -- Replacement changes the canonical bytes but preserves the resource's
        -- name, descriptions and PageEmbeddings. The new source must remain in
        -- the same presentable media family as the source it replaces.
}

rule ParticipantDeletesManagedFile {
    when: DeleteManagedFile(participant, graph, resource)

    let membership = core/Membership{graph: graph, participant: participant}

    requires: exists membership
    requires: membership.status = active
    requires: resource.graph = graph
    requires: resource.custody = internal

    ensures:
        for embedding in PageEmbeddings where resource = resource:
            not exists embedding
        not exists resource

    @guidance
        -- The participant may invoke the same action from the file catalogue or
        -- from an embedding's detail surface. When more than one embedding will
        -- disappear, the surface makes that scope explicit before submission.
}

rule PresentAudioArtifact {
    when: PresentAudio(audio)

    ensures: AudioArtifact.created(
        audio: audio,
        playback_available: audio.original_file != null,
        automatic_transcription_available: audio.original_file != null
    )
}

rule ParticipantChoosesVideoTranscript {
    when: FetchVideoTranscript(participant, page, video, language, original_language, provenance, timestamped_text, attached_block)

    let membership = core/Membership{graph: page.graph, participant: participant}

    requires: exists membership
    requires: membership.status = active
    requires: timestamped_text != ""

    ensures: VideoTranscript.created(
        video: video,
        language: language,
        original_language: original_language,
        provenance: provenance,
        timestamped_text: timestamped_text,
        extracted_at: now,
        attached_block: attached_block
    )

    @guidance
        -- Vera presents only tracks the provider says are available, as discrete
        -- legible choices grouped by provenance. Listing them does not fetch any
        -- transcript text. Only confirming one choice fetches and preserves that
        -- track. Cancelling leaves the page unchanged.
}

rule AutomaticallyTranscribeAudio {
    when: TranscribeAudio(participant, page, audio, transcript)

    let membership = core/Membership{graph: page.graph, participant: participant}

    requires: exists membership
    requires: membership.status = active
    requires: audio.original_file != null
    requires: audio.transcript_status = none

    ensures:
        audio.transcript = transcript
        audio.transcript_status = generated
}

rule ParticipantValidatesAudioTranscript {
    when: ValidateAudioTranscript(participant, page, audio)

    let membership = core/Membership{graph: page.graph, participant: participant}

    requires: exists membership
    requires: membership.status = active
    requires: audio.transcript != null
    requires: audio.transcript_status = generated

    ensures: audio.transcript_status = validated
}

rule ParticipantDeletesValidatedAudioSource {
    when: DeleteAudioSource(participant, page, audio)

    let membership = core/Membership{graph: page.graph, participant: participant}

    requires: exists membership
    requires: membership.status = active
    requires: audio.transcript_status = validated
    requires: audio.original_file != null

    ensures:
        audio.original_file = null
        audio.source_deleted_by = participant
        audio.source_deleted_at = now
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

invariant StoredSourceIsPreserved {
    for stored in StoredMedias:
        stored.source_preserved = true
}

invariant NativePresentationPreservesSource {
    for presentation in PresentedMedias:
        presentation.presented_natively = true
}

invariant DeletedAudioHasValidatedTranscript {
    for audio in Audios:
        audio.original_file = null implies audio.transcript_status = validated and audio.transcript != null
}

------------------------------------------------------------
-- Actor Declarations
------------------------------------------------------------

actor PageParticipant {
    within: core/Page
    identified_by: core/Participant where core/Membership{graph: within.graph, participant: this}.status = active
}

------------------------------------------------------------
-- Surfaces
------------------------------------------------------------

surface PageMedia {
    facing participant: PageParticipant
    context page: core/Page

    exposes:
        page.title

    provides:
        ParticipantAttachesMedia(participant, page, resource)
        ParticipantIngestsBinary(participant, page, resource)
        StoreMedia(resource)
        PresentMedia(resource)
        PresentAudio(audio)
        FetchVideoTranscript(participant, page, video, language, original_language, provenance, timestamped_text, attached_block)
        TranscribeAudio(participant, page, audio, transcript)
        ValidateAudioTranscript(participant, page, audio)
        DeleteAudioSource(participant, page, audio)
        RenameManagedFile(participant, page.graph, resource, file_name)
        ReplaceManagedFile(participant, page.graph, resource, replacement_source, replacement_media_type)
        DeleteManagedFile(participant, page.graph, resource)

    contracts:
        fulfils NativeMediaSupport
}

surface MediaAdministration {
    facing participant: core/VeraParticipant
    context graph: core/Graph

    exposes:
        for resource in MediaResources where graph = graph:
            resource.title
            resource.file_name
            resource.source_revision
            resource.custody

    provides:
        RenameManagedFile(participant, graph, resource, file_name)
        ReplaceManagedFile(participant, graph, resource, replacement_source, replacement_media_type)
        DeleteManagedFile(participant, graph, resource)

    contracts:
        fulfils NativeMediaSupport
}

------------------------------------------------------------
-- Deferred Specifications
------------------------------------------------------------

deferred ExecutableContentSandbox.present -- see: executable-content-sandbox.allium

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "Which media types must Vera edit directly, rather than only store and present?"
open question "May a canvas sketch receive an explicit read-only projection of graph data as input?"
