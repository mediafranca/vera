# Copia este archivo como fly.toml y reemplaza el nombre de la aplicación.
app = "tu-vera"
primary_region = "gru"
kill_signal = "SIGTERM"
kill_timeout = 120

[build]
  dockerfile = "Dockerfile"

[env]
  VERA_OWNER = "participant:tu-identidad"
  VERA_OWNER_NAME = "Tu nombre"
  VERA_PROFILE = "personal"

[http_service]
  internal_port = 4173
  force_https = true
  auto_stop_machines = "off"
  auto_start_machines = true
  min_machines_running = 1
  processes = ["app"]

  [[http_service.checks]]
    grace_period = "20s"
    interval = "30s"
    method = "GET"
    timeout = "5s"
    path = "/health"

[[mounts]]
  source = "vera_data"
  destination = "/data"

[[vm]]
  # 2 GiB basta para el perfil base. La síntesis local con Kokoro alcanzó
  # 2,49 GiB de pico en Alexei; esta plantilla reserva margen para voz activa.
  memory = "4gb"
  cpu_kind = "shared"
  cpus = 1
