{
  "name": "vera",
  "version": "0.6.9",
  "private": true,
  "type": "module",
  "description": "Memoria personal soberana: corpus versionado, editable, replicable y auditable",
  "author": {
    "name": "Herbert Spencer y colaboradores de Vera",
    "email": "hspencer@ead.cl"
  },
  "homepage": "https://vera.mediafranca.net/vera/",
  "main": "dist/desktop/main.mjs",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "spec": "allium check specs/",
    "spec:analyse": "allium analyse specs/",
    "traceability:check": "node scripts/check-traceability.mjs",
    "upstream:check": "node scripts/check-upstream.mjs --fetch",
    "preflight": "npm run upstream:check && npm run traceability:check",
    "test": "node --test \"packages/*/test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/web",
    "build": "npm run build --workspace @vera/web",
    "build:desktop": "npm run build && node scripts/build-desktop.mjs",
    "pack:windows": "npm run build:desktop && electron-builder --win nsis portable --x64",
    "pack:mac": "npm run build:desktop && electron-builder --mac dmg zip --universal",
    "pack:linux": "npm run build:desktop && electron-builder --linux AppImage deb --x64",
    "release:verify-tag": "node scripts/verify-release-tag.mjs",
    "import": "node packages/importer/src/persist.ts",
    "serve": "node packages/server/src/main.ts",
    "initialize": "node packages/server/src/initialize.ts",
    "owner:credential": "node packages/server/src/issue-owner.ts",
    "owner:enroll-passkey": "node packages/server/src/enroll-owner-passkey.ts",
    "project:public": "node packages/store/src/public-project-cli.ts",
    "backup:data": "./scripts/backup-data.sh",
    "dev": "trap 'kill 0' INT TERM EXIT; npm run watch --workspace @vera/web & npm run serve",
    "deploy": "./scripts/deploy.sh",
    "restart": "./scripts/serve.sh restart",
    "stop": "./scripts/serve.sh stop"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "electron": "^44.1.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "fast-check": "^4.1.1",
    "typescript": "^5.9.0"
  },
  "build": {
    "appId": "net.mediafranca.vera",
    "productName": "Vera",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mediafranca",
        "repo": "vera"
      }
    ],
    "files": [
      "dist/desktop/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "packages/web/dist",
        "to": "web"
      },
      {
        "from": "schema/schema.sql",
        "to": "schema.sql"
      },
      {
        "from": "node_modules/p5/lib/p5.min.js",
        "to": "p5.min.js"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "12.0",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "packages/web/public/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
