node_modules/
benchmarks/private/
packages/web/dist/
dist/
release/
*.tsbuildinfo

# La base canónica y sus archivos WAL nunca se versionan: git recibe la
# proyección Markdown determinista, no el motor de almacenamiento.
*.sqlite
*.sqlite-wal
*.sqlite-shm
data/

# Almacén de objetos direccionado por hash
objects/

# Los secretos de esta instancia. `.env.example` sí se versiona: dice qué hay que
# llenar sin decir con qué. Un secreto en git no se borra borrándolo — queda en
# el historial, en cada clon y en cada fork.
.env
.env.*
!.env.example

# El registro del servidor local. Es de esta máquina, no del proyecto.
.vera-server.log

# Espacios de trabajo locales de asistentes. Pueden contener repositorios
# anidados y jamás forman parte del producto.
.claude/
.codex/
.allium-loop/
