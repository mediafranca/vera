# Configuración de una instancia de Vera.
#
# Copia este archivo a `.env` y llénalo. `.env` no se versiona nunca: lleva los
# secretos de una instancia concreta. Este sí, y por eso dice qué hay que llenar
# sin decir con qué.
#
# Nada de esto es obligatorio. Vera corre sin `.env` con los valores de abajo,
# que son los que sirven en la máquina de quien la escribe. Lo que se pone aquí
# se pisa con un argumento en la línea de comandos, porque quien escribe un
# argumento lo escribió para esa corrida.


# --- Dónde escucha ----------------------------------------------------------

VERA_PORT=4173

# Loopback. Cambiar esto es una decisión consciente y hoy tiene un costo: las
# personas todavía no se autentican ante Vera (identity-access.allium lo declara
# como pregunta abierta), así que fuera de loopback cualquiera que alcance el
# puerto escribe como el dueño. La forma segura de exponer Vera hoy es dejarla en
# 127.0.0.1 y poner delante algo que termine TLS y controle quién llega —
# `tailscale serve` en esta instalación.
VERA_HOST=127.0.0.1


# --- De quién es este grafo -------------------------------------------------
#
# Quien firma todo lo que se escriba en esta instancia. Sin credencial se escribe
# como el dueño, así que esto no es una etiqueta: es la procedencia de cada
# bloque, y Vera trata justamente de eso.
#
# Ponlo ANTES de escribir nada. Cambiarlo después no reescribe lo ya escrito —ni
# debe—: lo firmado por quien estuviera antes sigue siendo suyo.

VERA_OWNER=participant:tu-nombre
VERA_OWNER_NAME=Tu Nombre


# --- Dónde vive el corpus ---------------------------------------------------

# La base canónica. Es un archivo SQLite y no tiene usuario ni contraseña: quien
# puede leer el archivo puede leer el grafo, y quien puede escribirlo puede
# escribirlo. Su control de acceso son los permisos del sistema de archivos, y la
# raíz de confianza de una instancia soberana es tener el disco. No busques una
# VERA_DATABASE_PASSWORD: no existe, y que no exista es la decisión.
VERA_DATABASE=data/vera.sqlite

# El almacén direccionado por contenido: audio, imágenes, todo binario.
VERA_OBJECTS=objects

# La PWA construida, que el servidor sirve como estáticos.
VERA_WEB_ROOT=packages/web/dist


# --- Voz --------------------------------------------------------------------
#
# La transcripción corre en esta máquina y el audio no sale de ella. Vera busca
# los binarios en el PATH y además en `~/.local/bin`, `~/bin`, `/usr/local/bin` y
# los de Homebrew, así que normalmente no hay que decir nada aquí. Se apunta a
# mano cuando están en otra parte o cuando hay más de una versión instalada.

# VERA_FFMPEG=/usr/local/bin/ffmpeg
# VERA_WHISPER=/usr/local/bin/whisper-cli
# VERA_WHISPER_MODEL=/home/tu-usuario/.local/share/whisper/ggml-base.bin
VERA_WHISPER_LANGUAGE=es


# --- Modelos para procesar páginas -----------------------------------------
#
# Vera descubre los archivos GGUF del directorio indicado y los ofrece en el
# selector de «Procesar página». El binario llama-cli se busca como whisper-cli.

# VERA_LLAMA=/usr/local/bin/llama-cli
# VERA_LLAMA_MODELS_DIR=/home/tu-usuario/.local/share/llama
# VERA_LLAMA_MODEL=/home/tu-usuario/.local/share/llama/modelo-preferido.gguf

# OpenAI es opcional y externo: al elegir uno de estos modelos, el panel dice
# explícitamente que el contenido de la página sale de Vera. La clave sólo la
# lee el servidor y nunca se entrega al navegador ni se escribe en el corpus.
# Si hay clave y no se declara una lista, se ofrece gpt-5.6-luna.

# OPENAI_API_KEY=
# VERA_OPENAI_MODELS=gpt-5.6-luna,gpt-5.6-terra
# OPENAI_BASE_URL=https://api.openai.com/v1


# --- Credenciales de agentes ------------------------------------------------
#
# El secreto de una credencial se muestra UNA sola vez, al emitirla: Vera guarda
# lo que prueba el secreto y nunca el secreto (agent-participation.allium,
# @invariant TheSecretIsNeverStored). Si se pierde, no se recupera de nada que
# Vera tenga — se emite otra y se revoca la anterior.
#
# Guardar aquí el secreto de un agente no contradice ese invariante: quien lo
# guarda es el portador de la credencial, no Vera.
#
# Para emitir una:
#
#   curl -s -X POST http://127.0.0.1:4173/agents/credentials \
#     -H 'content-type: application/json' \
#     -d '{"participant":"participant:mi-agente","scopes":["read","write"],"label":"mi agente"}'
#
# La persona propietaria obtiene su primera credencial directamente desde la
# base que posee la máquina. No existe una ruta HTTP equivalente: un túnel local
# también llegaría por loopback y no debe poder alcanzar la raíz de confianza.
#
#   npm run owner:credential -- data/vera.sqlite "navegador local"
#
# Alcances posibles: read, write, discard. Se dan los que el agente necesita y no
# más: el alcance se comprueba contra cada cambio, no una vez en la puerta.
#
# Y para usarla:
#
#   curl -H "authorization: Bearer $VERA_AGENT_TOKEN" ...
#
# El nombre de la variable es de quien la escribe: Vera no lee ninguna. Con más
# de un agente conviene una por cada uno, dicha por el agente y no por el número.

VERA_AGENT_TOKEN=


# --- Por dónde se alcanza esta Vera desde otro equipo ------------------------
#
# Vera escucha en loopback y quien la publica elige el frente. Una manera es
# `tailscale serve`, que termina TLS y sólo deja entrar a los equipos de la
# tailnet; el nombre de abajo es el que esa orden imprime al publicarla.
#
# Se declara aquí para que la página «la puerta MCP» pueda dictar la conexión de
# un cliente MCP que corra en otro equipo —el portátil, el teléfono—, que no
# puede usar 127.0.0.1 porque ahí no hay ninguna Vera. Vacío significa que no se
# sabe, y la página lo dice en vez de inventar una dirección que puede no existir.
#
# Ojo con `tailscale funnel`, que se parece y no es lo mismo: publica en internet
# entero. Mientras las personas no se autentiquen ante Vera, eso es dejar que
# cualquiera escriba firmando como el dueño.
VERA_REACHABLE_AT=https://vera.tu-tailnet.ts.net

# Una conexión stdio iniciada por ssh puede abrir aquí una credencial cifrada,
# sin copiar el secreto al equipo cliente ni ponerlo en su config.toml.
VERA_MCP_REMOTE_CLIENT=
VERA_MCP_REMOTE_CREDENTIAL_FILE=
VERA_MCP_REMOTE_CREDENTIAL_NAME=


# --- Sitio público -----------------------------------------------------------
#
# El mismo servidor y la misma aplicación atienden este origen como `anybody`:
# sólo lectura y sólo las publicaciones explícitas. La autorización ocurre en
# el servidor; no depende de esconder botones.

# Sólo sirven para sembrar una instalación anterior a VERA:Publicación. Una vez
# que el sitio existe, título, URL canónica y portada se gobiernan en esa página.
VERA_PUBLIC_DOMAIN=https://vera.example
VERA_PUBLIC_TITLE=Vera
# Opcional: adaptador de exportación estática, no la cara canónica del sitio.
VERA_PUBLIC_OUTPUT=../vera-public
# Listener loopback con la frontera `anybody`, para preview o proxy público.
VERA_PUBLIC_PREVIEW_PORT=4174
# La dirección Tailscale que abre el botón de vista previa de VERA:Publicación.
VERA_PUBLIC_PREVIEW_URL=https://vera-preview.tu-tailnet.ts.net
# Origen loopback de Streamable HTTP que el dominio público expone únicamente
# en /mcp. Sin este valor, el dominio público no ofrece ninguna puerta MCP.
# VERA_PUBLIC_MCP_ORIGIN=http://127.0.0.1:4180
